{
  "name": "scroll-horizontal-button",
  "components": [
    {
      "name": "ScrollHorizontalButton",
      "props": [
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "direction",
          "type": "\"right\" | \"left\"",
          "required": true
        },
        {
          "name": "scrollContainerRef",
          "type": "React.RefObject<HTMLDivElement | null>",
          "required": true
        },
        {
          "name": "singleClickJumpMode",
          "type": "ScrollHorizontalButtonJumpMode"
        },
        {
          "name": "doubleClickJumpMode",
          "type": "ScrollHorizontalButtonJumpMode",
          "default": "\"edge\""
        },
        {
          "name": "onJumpToEdge",
          "type": "(() => void)"
        },
        {
          "name": "onJumpToNearestConcern",
          "type": "((direction: \"left\" | \"right\") => void)"
        },
        {
          "name": "onJumpToFirstLastConcern",
          "type": "((direction: \"left\" | \"right\") => void)"
        },
        {
          "name": "singleStepPx",
          "type": "number",
          "default": "DEFAULT_SINGLE_STEP_PX"
        },
        {
          "name": "speedPxPerFrame",
          "type": "number",
          "default": "DEFAULT_SPEED_PX_PER_FRAME"
        },
        {
          "name": "holdDelayMs",
          "type": "number",
          "default": "DEFAULT_HOLD_DELAY_MS"
        },
        {
          "name": "size",
          "type": "\"default\" | \"strip\"",
          "default": "\"default\""
        },
        {
          "name": "showsInstructions",
          "type": "boolean",
          "default": "false"
        }
      ]
    }
  ],
  "examples": [
    {
      "title": "click · hold · double-click",
      "imports": [
        "import { ScrollHorizontalButton } from \"@/components/standard/scroll-horizontal-button\""
      ],
      "setup": "const SCROLL_STRIP_ITEMS = Array.from(\n  { length: 18 },\n  (_, index) => `Chip ${index + 1}`\n)\n\nconst SCROLL_STRIP_STEP_PX = 140",
      "code": "<div className=\"relative w-full overflow-hidden rounded-md border border-border py-3\">\n  <div className=\"absolute top-1/2 left-1 z-20 -translate-y-1/2\">\n    <ScrollHorizontalButton\n      direction=\"left\"\n      scrollContainerRef={scrollContainerRef}\n      onJumpToEdge={jumpToStart}\n      singleStepPx={SCROLL_STRIP_STEP_PX}\n    />\n  </div>\n  <div className=\"absolute top-1/2 right-1 z-20 -translate-y-1/2\">\n    <ScrollHorizontalButton\n      direction=\"right\"\n      scrollContainerRef={scrollContainerRef}\n      onJumpToEdge={jumpToEnd}\n      singleStepPx={SCROLL_STRIP_STEP_PX}\n    />\n  </div>\n  <div\n    ref={scrollContainerRef}\n    className=\"flex mask-x-from-85% mask-x-to-100% scrollbar-none gap-2 overflow-x-auto overflow-y-hidden px-3 py-1\"\n  >\n    {SCROLL_STRIP_ITEMS.map((label) => (\n      <div\n        key={label}\n        className=\"shrink-0 rounded-sm border border-border/60 bg-muted/30 px-3 py-2 text-xs text-foreground\"\n      >\n        {label}\n      </div>\n    ))}\n  </div>\n</div>"
    }
  ]
}
