      "code": "<Table headers={[\"Name\"]} rows={[[\"Jayrr\"]]} />"
    },
    {
      "imports": [
        "import { Table } from \"@/components/standard/table\""
      ],
      "code": "<Table\n  headers={[\"Job\", \"Hours\", \"Status\"]}\n  rows={[\n    [\"1001\", \"8.0\", \"Open\"],\n    [\"1002\", \"4.5\", \"Hold\"],\n  ]}\n/>"
    }
  ]
}
