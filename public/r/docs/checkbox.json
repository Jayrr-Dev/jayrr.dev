  "examples": [
    {
      "title": "Checkbox",
      "imports": [
        "import { RendersDemoCard } from \"./rendersDemoCard\"",
        "import { Checkbox } from \"@/components/ui/checkbox\"",
        "import { Label } from \"@/components/ui/label\""
      ],
      "code": "<RendersDemoCard>\n  <div className=\"flex items-center gap-2\">\n    <Checkbox id=\"terms\" defaultChecked />\n    <Label htmlFor=\"terms\">Accept terms</Label>\n  </div>\n</RendersDemoCard>"
    },
    {
      "title": "Checkbox",
      "imports": [
        "import { RendersDemoCard } from \"./rendersDemoCard\"",
        "import { Checkbox } from \"@/components/ui/checkbox\"",
        "import { Label } from \"@/components/ui/label\""
      ],
      "setup": "function TypeCard({\n  label,\n  children,\n  wide,\n}: {\n  label: string\n  children: ReactNode\n  wide?: boolean\n}) {\n  let className: string | undefined\n\n  if (wide) {\n    className = \"w-full max-w-xl\"\n  }\n\n  return (\n    <RendersDemoCard className={className} label={label}>\n      {children}\n    </RendersDemoCard>\n  )\n}",
      "code": "<>\n  <TypeCard label=\"unchecked\">\n    <div className=\"flex items-center gap-2\">\n      <Checkbox id=\"open\" />\n      <Label htmlFor=\"open\">Open</Label>\n    </div>\n  </TypeCard>\n  <TypeCard label=\"disabled\">\n    <div className=\"flex items-center gap-2\">\n      <Checkbox id=\"locked\" disabled defaultChecked />\n      <Label htmlFor=\"locked\">Locked</Label>\n    </div>\n  </TypeCard>\n</>"
    }
  ]
}
