{
  "name": "distort",
  "components": [
    {
      "name": "Distort",
      "description": "Spatial effect: waves, ripple, warp or blur.",
      "props": [
        {
          "name": "style",
          "type": "React.CSSProperties"
        },
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "opacity",
          "type": "number",
          "description": "0–1."
        },
        {
          "name": "blend",
          "type": "import(\"C:/Users/Work/Projects/jayrr.dev/components/standard/layer\").LayerBlend"
        },
        {
          "name": "kind",
          "type": "\"blur\" | \"ripple\" | \"waves\" | \"warp\"",
          "default": "\"waves\""
        },
        {
          "name": "strength",
          "type": "number",
          "description": "Displacement in px, or blur radius for `blur`."
        },
        {
          "name": "frequency",
          "type": "[number, number]",
          "description": "feTurbulence baseFrequency as [x, y]."
        },
        {
          "name": "animate",
          "type": "boolean",
          "default": "false",
          "description": "Moves the distortion. Stops under reduced motion."
        },
        {
          "name": "duration",
          "type": "number",
          "default": "8",
          "description": "Seconds per animation loop."
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "description": "With children, distorts them. Without, distorts whatever is painted behind the layer. Backdrop displacement is Chromium only; blur works everywhere."
        }
      ]
    }
  ],
  "examples": []
}
