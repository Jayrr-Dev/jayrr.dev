{
  "name": "color-grade",
  "components": [
    {
      "name": "ColorGrade",
      "description": "Color treatment: sepia, black and white, saturation, duotone and more.",
      "props": [
        {
          "name": "style",
          "type": "React.CSSProperties"
        },
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "opacity",
          "type": "number",
          "description": "0–1."
        },
        {
          "name": "blend",
          "type": "import(\"C:/Users/Work/Projects/jayrr.dev/components/standard/layer\").LayerBlend"
        },
        {
          "name": "preset",
          "type": "\"muted\" | \"sepia\" | \"bw\" | \"noir\" | \"vivid\" | \"vintage\" | \"warm\" | \"cool\" | \"duotone\""
        },
        {
          "name": "adjust",
          "type": "ColorAdjust"
        },
        {
          "name": "duotone",
          "type": "[string, string]",
          "default": "[\"#1b0f3b\", \"#ffc98b\"]",
          "description": "Shadow and highlight hex colors for the duotone preset."
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "description": "With children, grades them. Without, grades whatever is painted behind the layer (backdrop), so it works over backgrounds you don't own."
        }
      ]
    }
  ],
  "examples": []
}
