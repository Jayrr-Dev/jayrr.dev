{
  "name": "email-button",
  "components": [
    {
      "name": "EmailButton",
      "props": [
        {
          "name": "rel",
          "type": "string"
        },
        {
          "name": "size",
          "type": "\"default\" | \"xs\" | \"sm\" | \"lg\""
        },
        {
          "name": "loading",
          "type": "boolean | \"spin-icon\"",
          "description": "Blocks clicks while an action runs. `true` shows a spinner before the label (in place of `leading`); `\"spin-icon\"` spins the `leading` icon."
        },
        {
          "name": "target",
          "type": "React.HTMLAttributeAnchorTarget"
        },
        {
          "name": "tone",
          "type": "\"link\" | \"default\" | \"outline\" | \"ghost\" | \"success\" | \"danger\" | \"quiet\" | \"inverse\" | \"inverse-outline\"",
          "default": "\"outline\""
        },
        {
          "name": "leading",
          "type": "React.ReactNode",
          "description": "Content before the label, usually an icon."
        },
        {
          "name": "trailing",
          "type": "React.ReactNode",
          "description": "Content after the label (and after `count`), usually an icon."
        },
        {
          "name": "shape",
          "type": "\"circle\" | \"default\" | \"pill\" | \"square\""
        },
        {
          "name": "iconOnly",
          "type": "boolean",
          "default": "false",
          "description": "Square button that holds only an icon (the children). Give it an `aria-label` for its accessible name."
        },
        {
          "name": "block",
          "type": "boolean",
          "description": "Stretches to the full width of its container."
        },
        {
          "name": "count",
          "type": "number",
          "description": "Number shown inline after the label as a notification badge."
        },
        {
          "name": "to",
          "type": "string | string[]",
          "required": true
        },
        {
          "name": "cc",
          "type": "string | string[]"
        },
        {
          "name": "bcc",
          "type": "string | string[]"
        },
        {
          "name": "subject",
          "type": "string"
        },
        {
          "name": "body",
          "type": "string"
        },
        {
          "name": "action",
          "type": "EmailAction",
          "default": "\"compose\"",
          "description": "\"compose\" opens the mail app; \"copy\" copies the address."
        },
        {
          "name": "copiedLabel",
          "type": "React.ReactNode",
          "default": "\"Copied\"",
          "description": "Label shown for a moment after the address is copied."
        },
        {
          "name": "onEmail",
          "type": "((action: EmailAction) => void)"
        },
        {
          "name": "onEmailError",
          "type": "((error: unknown) => void)"
        }
      ],
      "inherits": [
        "ButtonHTMLAttributes",
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "icon only",
      "imports": [
        "import { EmailButton } from \"@/components/standard/email-button\""
      ],
      "code": "<div className=\"flex gap-2\">\n  <EmailButton iconOnly to=\"hello@example.com\" />\n  <EmailButton\n    iconOnly\n    shape=\"circle\"\n    tone=\"quiet\"\n    to=\"hello@example.com\"\n    action=\"copy\"\n  />\n</div>"
    },
    {
      "title": "compose · subject and body",
      "imports": [
        "import { EmailButton } from \"@/components/standard/email-button\""
      ],
      "code": "<EmailButton\n  to=\"hello@example.com\"\n  subject=\"Project enquiry\"\n  body={\"Hi there,\\n\\nI'd like to talk about a project.\"}\n/>"
    },
    {
      "title": "copy address",
      "imports": [
        "import { EmailButton } from \"@/components/standard/email-button\""
      ],
      "code": "<EmailButton to=\"hello@example.com\" action=\"copy\" />"
    }
  ]
}
