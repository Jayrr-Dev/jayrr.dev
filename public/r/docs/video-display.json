{
  "name": "video-display",
  "components": [
    {
      "name": "VideoDisplay",
      "props": [
        {
          "name": "src",
          "type": "string"
        },
        {
          "name": "sources",
          "type": "VideoSource[]",
          "description": "Several encodings of one video; the browser plays the first it can."
        },
        {
          "name": "poster",
          "type": "string"
        },
        {
          "name": "title",
          "type": "string",
          "description": "Shown over the top of the frame while the controls are visible."
        },
        {
          "name": "tracks",
          "type": "VideoTrack[]",
          "description": "Caption or subtitle files (WebVTT)."
        },
        {
          "name": "ratio",
          "type": "number",
          "default": "16 / 9",
          "description": "Width / height."
        },
        {
          "name": "autoPlay",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "muted",
          "type": "boolean",
          "default": "false",
          "description": "Start muted; browsers only autoplay muted video."
        },
        {
          "name": "loop",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "controls",
          "type": "\"native\" | \"custom\"",
          "default": "\"custom\"",
          "description": "\"native\" uses the browser's own controls instead."
        },
        {
          "name": "rounded",
          "type": "boolean",
          "default": "true"
        },
        {
          "name": "onEnded",
          "type": "(() => void)"
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "autoplay · muted · loop · 4 / 3",
      "imports": [
        "import { VideoDisplay } from \"@/components/standard/video-display\""
      ],
      "setup": "const src = \"/samples/sample-video.mp4\"",
      "code": "<div className=\"w-full max-w-sm\">\n  <VideoDisplay src={src} autoPlay loop ratio={4 / 3} />\n</div>"
    },
    {
      "imports": [
        "import { VideoDisplay } from \"@/components/standard/video-display\""
      ],
      "setup": "const src = \"/samples/sample-video.mp4\"\n\nconst poster = \"/samples/sample-video-poster.jpg\"",
      "code": "<VideoDisplay\n  src={src}\n  poster={poster}\n  title=\"Mandelbrot zoom\"\n  tracks={[\n    {\n      src: \"/samples/sample-video.vtt\",\n      label: \"English\",\n      srcLang: \"en\",\n      default: true,\n    },\n  ]}\n/>"
    },
    {
      "title": "controls native",
      "imports": [
        "import { VideoDisplay } from \"@/components/standard/video-display\""
      ],
      "setup": "const src = \"/samples/sample-video.mp4\"\n\nconst poster = \"/samples/sample-video-poster.jpg\"",
      "code": "<div className=\"w-full max-w-sm\">\n  <VideoDisplay src={src} poster={poster} controls=\"native\" />\n</div>"
    }
  ]
}
