{
  "name": "standard-button",
  "components": [
    {
      "name": "Button",
      "props": [
        {
          "name": "size",
          "type": "\"default\" | \"xs\" | \"sm\" | \"lg\""
        },
        {
          "name": "tone",
          "type": "\"link\" | \"default\" | \"outline\" | \"ghost\" | \"success\" | \"danger\" | \"quiet\" | \"inverse\" | \"inverse-outline\""
        },
        {
          "name": "shape",
          "type": "\"circle\" | \"default\" | \"pill\" | \"square\""
        },
        {
          "name": "leading",
          "type": "React.ReactNode",
          "description": "Content before the label, usually an icon."
        },
        {
          "name": "trailing",
          "type": "React.ReactNode",
          "description": "Content after the label (and after `count`), usually an icon."
        },
        {
          "name": "count",
          "type": "number",
          "description": "Number shown inline after the label as a notification badge."
        },
        {
          "name": "iconOnly",
          "type": "boolean",
          "description": "Square button that holds only an icon (the children). Give it an `aria-label` for its accessible name."
        },
        {
          "name": "block",
          "type": "boolean",
          "description": "Stretches to the full width of its container."
        },
        {
          "name": "loading",
          "type": "boolean | \"spin-icon\"",
          "description": "Blocks clicks while an action runs. `true` shows a spinner before the label (in place of `leading`); `\"spin-icon\"` spins the `leading` icon."
        },
        {
          "name": "rel",
          "type": "string"
        },
        {
          "name": "href",
          "type": "string",
          "description": "Renders an `<a>` with the same look instead of a `<button>`."
        },
        {
          "name": "target",
          "type": "React.HTMLAttributeAnchorTarget"
        },
        {
          "name": "download",
          "type": "any"
        }
      ],
      "inherits": [
        "ButtonHTMLAttributes",
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "iconOnly shape circle",
      "imports": [
        "import { Button } from \"@/components/standard/button\"",
        "import { StarIcon } from \"lucide-react\""
      ],
      "code": "<Button iconOnly shape=\"circle\" tone=\"outline\" aria-label=\"Star\">\n  <StarIcon className=\"size-4\" />\n</Button>"
    },
    {
      "title": "href",
      "imports": [
        "import { Button } from \"@/components/standard/button\"",
        "import { ExternalLinkIcon } from \"lucide-react\""
      ],
      "code": "<Button\n  href=\"#gallery\"\n  tone=\"outline\"\n  trailing={<ExternalLinkIcon className=\"size-3.5\" />}\n>\n  Open gallery\n</Button>"
    },
    {
      "title": "loading spin-icon",
      "imports": [
        "import { Button } from \"@/components/standard/button\"",
        "import { RefreshCwIcon } from \"lucide-react\""
      ],
      "code": "<Button\n  tone=\"outline\"\n  loading=\"spin-icon\"\n  leading={<RefreshCwIcon className=\"size-4\" />}\n>\n  Syncing\n</Button>"
    },
    {
      "title": "size sm",
      "imports": [
        "import { Button } from \"@/components/standard/button\""
      ],
      "code": "<Button size=\"sm\">Small</Button>"
    }
  ]
}
