  "examples": [
    {
      "title": "Sheet",
      "imports": [
        "import { Button } from \"@/components/ui/button\"",
        "import { Sheet, SheetContent, SheetDescription, SheetHeader, SheetTitle, SheetTrigger } from \"@/components/ui/sheet\""
      ],
      "code": "<Sheet>\n  <SheetTrigger asChild>\n    <Button variant=\"outline\">Open sheet</Button>\n  </SheetTrigger>\n  <SheetContent>\n    <SheetHeader>\n      <SheetTitle>Library</SheetTitle>\n      <SheetDescription>Slides in from the side.</SheetDescription>\n    </SheetHeader>\n  </SheetContent>\n</Sheet>"
    },
    {
      "title": "footer",
      "imports": [
        "import { Button } from \"@/components/standard/button\"",
        "import { Sheet } from \"@/components/standard/sheet\"",
        "import { SheetClose } from \"@/components/ui/sheet\""
      ],
      "code": "<Sheet\n  title=\"Edit job\"\n  description=\"Changes save when you press Save.\"\n  trigger=\"Edit job\"\n  footer={\n    <div className=\"flex justify-end gap-2\">\n      <SheetClose asChild>\n        <Button tone=\"outline\">Cancel</Button>\n      </SheetClose>\n      <SheetClose asChild>\n        <Button>Save</Button>\n      </SheetClose>\n    </div>\n  }\n>\n  <p className=\"text-sm text-muted-foreground\">Form fields go here.</p>\n</Sheet>"
    },
    {
      "title": "Sheet",
      "imports": [
        "import { RendersDemoCard } from \"./rendersDemoCard\"",
        "import { Button } from \"@/components/ui/button\"",
        "import { Sheet, SheetContent, SheetHeader, SheetTitle, SheetTrigger } from \"@/components/ui/sheet\""
      ],
      "setup": "function TypeCard({\n  label,\n  children,\n  wide,\n}: {\n  label: string\n  children: ReactNode\n  wide?: boolean\n}) {\n  let className: string | undefined\n\n  if (wide) {\n    className = \"w-full max-w-xl\"\n  }\n\n  return (\n    <RendersDemoCard className={className} label={label}>\n      {children}\n    </RendersDemoCard>\n  )\n}\n\nconst sheetSides = [\"top\", \"left\", \"bottom\"] as const",
      "code": "<>\n  {sheetSides.map((side) => (\n    <TypeCard key={side} label={`side ${side}`}>\n      <Sheet>\n        <SheetTrigger asChild>\n          <Button variant=\"outline\">{side}</Button>\n        </SheetTrigger>\n        <SheetContent side={side}>\n          <SheetHeader>\n            <SheetTitle>{side}</SheetTitle>\n          </SheetHeader>\n        </SheetContent>\n      </Sheet>\n    </TypeCard>\n  ))}\n</>"
    }
  ]
}
