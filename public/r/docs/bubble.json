{
  "name": "bubble",
  "components": [
    {
      "name": "BubbleGroup",
      "props": [],
      "inherits": [
        "HTMLAttributes"
      ]
    },
    {
      "name": "Bubble",
      "props": [
        {
          "name": "variant",
          "type": "\"default\" | \"outline\" | \"secondary\" | \"ghost\" | \"destructive\" | \"muted\" | \"tinted\" | \"speech\"",
          "default": "\"default\""
        },
        {
          "name": "align",
          "type": "\"start\" | \"end\"",
          "default": "\"start\""
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    },
    {
      "name": "BubbleContent",
      "props": [
        {
          "name": "asChild",
          "type": "boolean",
          "default": "false"
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    },
    {
      "name": "BubbleReactions",
      "props": [
        {
          "name": "align",
          "type": "\"start\" | \"end\"",
          "default": "\"end\""
        },
        {
          "name": "side",
          "type": "\"top\" | \"bottom\"",
          "default": "\"bottom\""
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "Bubble",
      "imports": [
        "import { Bubble, BubbleContent } from \"@/components/ui/bubble\""
      ],
      "code": "<Bubble>\n  <BubbleContent>Hello</BubbleContent>\n</Bubble>"
    },
    {
      "title": "Bubble",
      "imports": [
        "import { RendersDemoCard } from \"./rendersDemoCard\"",
        "import { Bubble, BubbleContent } from \"@/components/ui/bubble\"",
        "import { TextTypewriter } from \"@/components/ui/text-effect\""
      ],
      "setup": "function TypeCard({\n  label,\n  children,\n  wide,\n}: {\n  label: string\n  children: ReactNode\n  wide?: boolean\n}) {\n  let className: string | undefined\n\n  if (wide) {\n    className = \"w-full max-w-xl\"\n  }\n\n  return (\n    <RendersDemoCard className={className} label={label}>\n      {children}\n    </RendersDemoCard>\n  )\n}\n\nconst bubbleVariants = [\n  \"secondary\",\n  \"muted\",\n  \"tinted\",\n  \"outline\",\n  \"ghost\",\n  \"speech\",\n  \"destructive\",\n] as const",
      "code": "<>\n  {bubbleVariants.map((variant) => (\n    <TypeCard key={variant} label={`variant ${variant}`}>\n      <Bubble variant={variant}>\n        <BubbleContent>Hello</BubbleContent>\n      </Bubble>\n    </TypeCard>\n  ))}\n  <TypeCard label=\"align end\">\n    <Bubble align=\"end\">\n      <BubbleContent>Hello</BubbleContent>\n    </Bubble>\n  </TypeCard>\n  <TypeCard label=\"speech align end\">\n    <Bubble variant=\"speech\" align=\"end\">\n      <BubbleContent>Hello</BubbleContent>\n    </Bubble>\n  </TypeCard>\n  <TypeCard label=\"speech typewriter\" wide>\n    <Bubble variant=\"speech\">\n      <BubbleContent>\n        <p className=\"font-medium\">\n          <TextTypewriter text=\"What's rattling in the bank?\" />\n        </p>\n      </BubbleContent>\n    </Bubble>\n  </TypeCard>\n</>"
    }
  ]
}
