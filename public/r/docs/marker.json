{
  "name": "marker",
  "components": [
    {
      "name": "Marker",
      "props": [
        {
          "name": "variant",
          "type": "\"separator\" | \"default\" | \"border\"",
          "default": "\"default\""
        },
        {
          "name": "asChild",
          "type": "boolean",
          "default": "false"
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    },
    {
      "name": "MarkerIcon",
      "props": [],
      "inherits": [
        "HTMLAttributes"
      ]
    },
    {
      "name": "MarkerContent",
      "props": [],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "Marker",
      "imports": [
        "import { Marker, MarkerContent, MarkerIcon } from \"@/components/ui/marker\"",
        "import { UserPlusIcon } from \"lucide-react\""
      ],
      "code": "<div className=\"flex w-full flex-col gap-3\">\n  <Marker variant=\"separator\">\n    <MarkerContent>Today</MarkerContent>\n  </Marker>\n  <Marker>\n    <MarkerIcon>\n      <UserPlusIcon />\n    </MarkerIcon>\n    <MarkerContent>Maya joined the channel</MarkerContent>\n  </Marker>\n</div>"
    },
    {
      "title": "Marker",
      "imports": [
        "import { RendersDemoCard } from \"./rendersDemoCard\"",
        "import { Marker, MarkerContent, MarkerIcon } from \"@/components/ui/marker\"",
        "import { LoaderIcon, PencilIcon, PinIcon, UserPlusIcon } from \"lucide-react\""
      ],
      "setup": "function TypeCard({\n  label,\n  children,\n  wide,\n}: {\n  label: string\n  children: ReactNode\n  wide?: boolean\n}) {\n  let className: string | undefined\n\n  if (wide) {\n    className = \"w-full max-w-xl\"\n  }\n\n  return (\n    <RendersDemoCard className={className} label={label}>\n      {children}\n    </RendersDemoCard>\n  )\n}",
      "code": "<>\n  <TypeCard label=\"system note\">\n    <Marker>\n      <MarkerIcon>\n        <UserPlusIcon />\n      </MarkerIcon>\n      <MarkerContent>Maya joined the channel</MarkerContent>\n    </Marker>\n  </TypeCard>\n  <TypeCard label=\"variant separator · date break\">\n    <Marker variant=\"separator\">\n      <MarkerContent>Today</MarkerContent>\n    </Marker>\n  </TypeCard>\n  <TypeCard label=\"status line\">\n    <Marker role=\"status\">\n      <MarkerIcon>\n        <LoaderIcon className=\"size-4 animate-spin\" />\n      </MarkerIcon>\n      <MarkerContent>Generating response…</MarkerContent>\n    </Marker>\n  </TypeCard>\n  <TypeCard label=\"variant border · section heading\">\n    <Marker variant=\"border\">\n      <MarkerIcon>\n        <PinIcon />\n      </MarkerIcon>\n      <MarkerContent>Pinned messages</MarkerContent>\n    </Marker>\n  </TypeCard>\n  <TypeCard label=\"with a link\">\n    <Marker>\n      <MarkerIcon>\n        <PencilIcon />\n      </MarkerIcon>\n      <MarkerContent>\n        Edited 2 minutes ago · <a href=\"#history\">View history</a>\n      </MarkerContent>\n    </Marker>\n  </TypeCard>\n  <TypeCard label=\"variant separator · end of list\">\n    <Marker variant=\"separator\">\n      <MarkerContent>No older messages</MarkerContent>\n    </Marker>\n  </TypeCard>\n</>"
    }
  ]
}
