{
  "name": "volume-button",
  "components": [
    {
      "name": "VolumeButton",
      "props": [
        {
          "name": "value",
          "type": "number"
        },
        {
          "name": "defaultValue",
          "type": "number",
          "default": "0.8"
        },
        {
          "name": "onValueChange",
          "type": "((value: number) => void)"
        },
        {
          "name": "muted",
          "type": "boolean"
        },
        {
          "name": "defaultMuted",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "onMutedChange",
          "type": "((muted: boolean) => void)"
        },
        {
          "name": "media",
          "type": "React.RefObject<HTMLMediaElement | null>",
          "description": "Element whose volume and muted state follow this control."
        },
        {
          "name": "expand",
          "type": "\"popover\" | \"always\" | \"hover\"",
          "default": "\"hover\"",
          "description": "\"hover\" shows the slider on hover or focus; \"always\" keeps it open; \"popover\" opens it in a popover from the button."
        },
        {
          "name": "orientation",
          "type": "\"horizontal\" | \"vertical\"",
          "default": "expand === \"popover\" ? \"vertical\" : \"horizontal\"",
          "description": "Slider direction. Popovers default to vertical, inline to horizontal."
        },
        {
          "name": "size",
          "type": "\"default\" | \"xs\" | \"sm\" | \"lg\"",
          "default": "\"default\""
        },
        {
          "name": "tone",
          "type": "\"link\" | \"default\" | \"outline\" | \"ghost\" | \"success\" | \"danger\" | \"quiet\" | \"inverse\" | \"inverse-outline\"",
          "default": "\"ghost\""
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false"
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "outline · starts muted",
      "imports": [
        "import { VolumeButton } from \"@/components/standard/volume-button\""
      ],
      "code": "<VolumeButton tone=\"outline\" defaultMuted />"
    },
    {
      "title": "popover · click to open",
      "imports": [
        "import { VolumeButton } from \"@/components/standard/volume-button\""
      ],
      "code": "<VolumeButton expand=\"popover\" tone=\"outline\" />"
    },
    {
      "title": "vertical · hover to adjust",
      "imports": [
        "import { VolumeButton } from \"@/components/standard/volume-button\""
      ],
      "code": "<VolumeButton orientation=\"vertical\" />"
    },
    {
      "title": "hover to adjust",
      "imports": [
        "import { VolumeButton } from \"@/components/standard/volume-button\""
      ],
      "code": "<VolumeButton />"
    }
  ]
}
