{
  "name": "standard-checkbox",
  "components": [
    {
      "name": "Checkbox",
      "props": [
        {
          "name": "label",
          "type": "React.ReactNode",
          "description": "Renders a clickable label next to the box."
        },
        {
          "name": "description",
          "type": "React.ReactNode"
        },
        {
          "name": "invalid",
          "type": "boolean",
          "description": "Shows the error style. Same as passing aria-invalid."
        },
        {
          "name": "size",
          "type": "\"default\" | \"sm\"",
          "default": "\"default\""
        },
        {
          "name": "appearance",
          "type": "\"default\" | \"card\"",
          "default": "\"default\"",
          "description": "card: a bordered tile around box and label, highlighted while checked. Needs a label."
        },
        {
          "name": "indeterminate",
          "type": "boolean",
          "default": "false",
          "description": "Shows the mixed state, e.g. for a \"select all\" over a partial selection."
        }
      ],
      "inherits": [
        "HTMLAttributes",
        "InputHTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "appearance card",
      "imports": [
        "import { Checkbox } from \"@/components/standard/checkbox\""
      ],
      "code": "<div className=\"grid w-full gap-2\">\n  <Checkbox\n    appearance=\"card\"\n    label=\"Nightly backup\"\n    description=\"Copies every job at 2 am.\"\n    defaultChecked\n  />\n  <Checkbox\n    appearance=\"card\"\n    label=\"Weekly report\"\n    description=\"Emailed Monday morning.\"\n  />\n</div>"
    },
    {
      "title": "invalid",
      "imports": [
        "import { Checkbox } from \"@/components/standard/checkbox\""
      ],
      "code": "<Checkbox label=\"I accept the terms\" invalid />"
    },
    {
      "title": "indeterminate",
      "imports": [
        "import { Checkbox } from \"@/components/standard/checkbox\""
      ],
      "code": "<Checkbox label=\"Select all\" indeterminate />"
    },
    {
      "title": "size sm",
      "imports": [
        "import { Checkbox } from \"@/components/standard/checkbox\""
      ],
      "code": "<Checkbox\n  size=\"sm\"\n  label=\"Show archived\"\n  description=\"Hidden by default.\"\n/>"
    }
  ]
}
