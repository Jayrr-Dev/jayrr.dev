{
  "name": "copy-button",
  "components": [
    {
      "name": "CopyButton",
      "props": [
        {
          "name": "rel",
          "type": "string"
        },
        {
          "name": "onCopy",
          "type": "(React.ClipboardEventHandler<HTMLButtonElement> & ((text: string) => void))"
        },
        {
          "name": "size",
          "type": "\"default\" | \"xs\" | \"sm\" | \"lg\""
        },
        {
          "name": "loading",
          "type": "boolean | \"spin-icon\"",
          "description": "Blocks clicks while an action runs. `true` shows a spinner before the label (in place of `leading`); `\"spin-icon\"` spins the `leading` icon."
        },
        {
          "name": "target",
          "type": "React.HTMLAttributeAnchorTarget"
        },
        {
          "name": "tone",
          "type": "\"link\" | \"default\" | \"outline\" | \"ghost\" | \"success\" | \"danger\" | \"quiet\" | \"inverse\" | \"inverse-outline\"",
          "default": "\"outline\""
        },
        {
          "name": "leading",
          "type": "React.ReactNode",
          "description": "Content before the label, usually an icon."
        },
        {
          "name": "trailing",
          "type": "React.ReactNode",
          "description": "Content after the label (and after `count`), usually an icon."
        },
        {
          "name": "shape",
          "type": "\"circle\" | \"default\" | \"pill\" | \"square\""
        },
        {
          "name": "iconOnly",
          "type": "boolean",
          "default": "false",
          "description": "Square button that holds only an icon (the children). Give it an `aria-label` for its accessible name."
        },
        {
          "name": "block",
          "type": "boolean",
          "description": "Stretches to the full width of its container."
        },
        {
          "name": "count",
          "type": "number",
          "description": "Number shown inline after the label as a notification badge."
        },
        {
          "name": "value",
          "type": "string | (() => string | Promise<string>)",
          "required": true,
          "description": "The text to copy, or a function that returns it when clicked."
        },
        {
          "name": "copiedLabel",
          "type": "React.ReactNode",
          "default": "\"Copied\"",
          "description": "Label shown for a moment after the text is copied."
        },
        {
          "name": "label",
          "type": "string",
          "default": "\"Copy\"",
          "description": "Accessible name when `iconOnly`."
        },
        {
          "name": "onCopyError",
          "type": "((error: unknown) => void)"
        }
      ],
      "inherits": [
        "ButtonHTMLAttributes",
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "custom label",
      "imports": [
        "import { CopyButton } from \"@/components/standard/copy-button\""
      ],
      "code": "<CopyButton value=\"https://jayrr.dev\" tone=\"default\">\n  Copy link\n</CopyButton>"
    },
    {
      "title": "copy text",
      "imports": [
        "import { CopyButton } from \"@/components/standard/copy-button\""
      ],
      "code": "<CopyButton value=\"npx shadcn add @jayrr/copy-button\" />"
    }
  ]
}
