{
  "name": "sine-wave",
  "components": [
    {
      "name": "SineWave",
      "props": [
        {
          "name": "shape",
          "type": "\"square\" | \"triangle\" | \"sine\" | \"sawtooth\"",
          "default": "\"sine\""
        },
        {
          "name": "amplitude",
          "type": "number",
          "default": "0.6",
          "description": "Height of the crests, from 0 (a flat line) to 1 (touching the edges)."
        },
        {
          "name": "frequency",
          "type": "number",
          "default": "3",
          "description": "Full cycles across the width."
        },
        {
          "name": "speed",
          "type": "number",
          "default": "0.5",
          "description": "Cycles the wave drifts per second; negative drifts right, 0 holds still."
        },
        {
          "name": "phase",
          "type": "number",
          "default": "0",
          "description": "Shifts the wave, in cycles."
        },
        {
          "name": "lines",
          "type": "number",
          "default": "1",
          "description": "How many traces to draw; extra lines trail the first, fainter each time."
        },
        {
          "name": "spread",
          "type": "number",
          "default": "0.06",
          "description": "Phase between stacked lines, in cycles."
        },
        {
          "name": "thickness",
          "type": "number",
          "default": "2.5",
          "description": "Stroke width in CSS pixels."
        },
        {
          "name": "color",
          "type": "string",
          "description": "Trace color; any CSS color, including `var(--token)`. Defaults to the text color."
        },
        {
          "name": "glow",
          "type": "boolean",
          "default": "false",
          "description": "A soft halo around the trace, like phosphor."
        },
        {
          "name": "grid",
          "type": "boolean",
          "default": "false",
          "description": "Graph-paper lines behind the trace."
        },
        {
          "name": "gridColumns",
          "type": "number",
          "default": "20"
        },
        {
          "name": "gridRows",
          "type": "number",
          "default": "10"
        },
        {
          "name": "axis",
          "type": "boolean",
          "default": "false",
          "description": "A dashed line through the middle, where the wave crosses zero."
        },
        {
          "name": "intro",
          "type": "boolean",
          "default": "true",
          "description": "Starts as a flat line and swells to its amplitude."
        },
        {
          "name": "paused",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "label",
          "type": "string",
          "description": "Accessible description; defaults to the shape."
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "echoes · stacked lines",
      "imports": [
        "import { SineWave } from \"@/components/standard/sine-wave\""
      ],
      "code": "<div className=\"flex w-full flex-col gap-3\">\n  <SineWave\n    lines={12}\n    spread={0.035}\n    frequency={2}\n    amplitude={0.75}\n    thickness={1.5}\n    color=\"oklch(0.85 0.14 200)\"\n    className=\"h-40\"\n  />\n  <div className=\"grid w-full grid-cols-2 gap-3\">\n    <SineWave\n      lines={5}\n      spread={0.12}\n      frequency={1.5}\n      speed={0.25}\n      color=\"oklch(0.8 0.17 70)\"\n      glow\n    />\n    <SineWave\n      lines={8}\n      spread={-0.05}\n      frequency={4}\n      speed={-0.6}\n      thickness={1.5}\n    />\n  </div>\n</div>"
    },
    {
      "title": "shapes",
      "imports": [
        "import { SineWave, sineWaveShapes } from \"@/components/standard/sine-wave\""
      ],
      "code": "<div className=\"grid w-full grid-cols-2 gap-3\">\n  {sineWaveShapes.map((entry) => (\n    <div key={entry} className=\"flex flex-col gap-1.5\">\n      <SineWave\n        shape={entry}\n        frequency={4}\n        grid\n        gridColumns={16}\n        gridRows={6}\n        axis\n        color=\"oklch(0.93 0.21 118)\"\n        className=\"h-24\"\n      />\n      <p className=\"font-mono text-xs text-muted-foreground\">{entry}</p>\n    </div>\n  ))}\n</div>"
    }
  ]
}
