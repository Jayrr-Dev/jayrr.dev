{
  "name": "control-bar",
  "components": [
    {
      "name": "ControlBar",
      "props": [],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "wraps when narrow",
      "imports": [
        "import { Chip } from \"@/components/standard/chip\"",
        "import { ControlBar } from \"@/components/standard/control-bar\""
      ],
      "code": "<ControlBar>\n  {[\"Draft\", \"Review\", \"Approved\", \"Shipped\", \"Archived\"].map(\n    (status) => (\n      <Chip key={status}>{status}</Chip>\n    )\n  )}\n</ControlBar>"
    },
    {
      "title": "unsaved changes",
      "imports": [
        "import { Button } from \"@/components/standard/button\"",
        "import { ControlBar } from \"@/components/standard/control-bar\""
      ],
      "code": "<ControlBar>\n  <span className=\"text-sm text-muted-foreground\">\n    {changes > 0 ? `${changes} unsaved changes` : \"All changes saved\"}\n  </span>\n  <span className=\"ms-auto flex items-center gap-2\">\n    <Button\n      tone=\"ghost\"\n      size=\"sm\"\n      disabled={changes === 0}\n      onClick={() => setChanges(0)}\n    >\n      Discard\n    </Button>\n    <Button\n      size=\"sm\"\n      disabled={changes === 0}\n      onClick={() => setChanges(0)}\n    >\n      Save\n    </Button>\n  </span>\n</ControlBar>"
    },
    {
      "title": "live toggle and shortcut",
      "imports": [
        "import { ControlBar } from \"@/components/standard/control-bar\"",
        "import { Kbd } from \"@/components/standard/kbd\"",
        "import { Switch } from \"@/components/standard/switch\""
      ],
      "code": "<ControlBar>\n  <Switch\n    size=\"sm\"\n    label={live ? \"Live updates\" : \"Paused\"}\n    checked={live}\n    onCheckedChange={setLive}\n  />\n  <span className=\"ms-auto flex items-center gap-1.5 text-xs text-muted-foreground\">\n    Search <Kbd>⌘K</Kbd>\n  </span>\n</ControlBar>"
    },
    {
      "title": "filter chips",
      "imports": [
        "import { Button } from \"@/components/standard/button\"",
        "import { Chip, ChipGroup } from \"@/components/standard/chip\"",
        "import { ControlBar } from \"@/components/standard/control-bar\""
      ],
      "code": "<ControlBar>\n  <ChipGroup aria-label=\"Filters\">\n    {filters.map((filter) => (\n      <Chip\n        key={filter}\n        selected={on.includes(filter)}\n        onSelectedChange={(selected) =>\n          setOn((current) =>\n            selected\n              ? [...current, filter]\n              : current.filter((item) => item !== filter)\n          )\n        }\n      >\n        {filter}\n      </Chip>\n    ))}\n  </ChipGroup>\n  <Button\n    tone=\"ghost\"\n    size=\"sm\"\n    className=\"ms-auto\"\n    disabled={on.length === 0}\n    onClick={() => setOn([])}\n  >\n    Clear\n  </Button>\n</ControlBar>"
    }
  ]
}
