{
  "name": "pdf-display",
  "components": [
    {
      "name": "PdfDisplay",
      "props": [
        {
          "name": "src",
          "type": "string",
          "required": true
        },
        {
          "name": "title",
          "type": "string",
          "description": "Defaults to the file name in `src`."
        },
        {
          "name": "page",
          "type": "number",
          "default": "1",
          "description": "The page to open on, from 1."
        },
        {
          "name": "zoom",
          "type": "PdfZoom",
          "default": "\"page-width\"",
          "description": "How the first page fits, or a scale such as 1.5."
        },
        {
          "name": "height",
          "type": "string | number",
          "default": "560",
          "description": "CSS height of the viewer."
        },
        {
          "name": "viewerToolbar",
          "type": "boolean",
          "default": "true",
          "description": "Show the browser viewer's own toolbar."
        },
        {
          "name": "download",
          "type": "boolean",
          "default": "true",
          "description": "Show the download action."
        },
        {
          "name": "header",
          "type": "boolean",
          "default": "true",
          "description": "Show the title bar with its open and download actions. The border stays; `bare` drops both."
        },
        {
          "name": "scrollbar",
          "type": "boolean",
          "default": "true",
          "description": "Show the viewer's scrollbar. When false it is clipped out of view; the document still scrolls with the wheel, touch and keys."
        },
        {
          "name": "bare",
          "type": "boolean",
          "default": "false"
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "page 2 · page-fit · no viewer toolbar",
      "imports": [
        "import { PdfDisplay } from \"@/components/standard/pdf-display\""
      ],
      "setup": "const sample = \"/samples/sample-document.pdf\"",
      "code": "<PdfDisplay\n  src={sample}\n  page={2}\n  zoom=\"page-fit\"\n  viewerToolbar={false}\n  height={360}\n/>"
    },
    {
      "title": "header false · scrollbar false",
      "imports": [
        "import { PdfDisplay } from \"@/components/standard/pdf-display\""
      ],
      "setup": "const sample = \"/samples/sample-document.pdf\"",
      "code": "<PdfDisplay\n  src={sample}\n  header={false}\n  scrollbar={false}\n  viewerToolbar={false}\n  height={360}\n/>"
    },
    {
      "imports": [
        "import { PdfDisplay } from \"@/components/standard/pdf-display\""
      ],
      "setup": "const sample = \"/samples/sample-document.pdf\"",
      "code": "<PdfDisplay src={sample} title=\"Display primitives\" height={520} />"
    }
  ]
}
