{
  "name": "toggle-group",
  "components": [
    {
      "name": "ToggleGroup",
      "props": [
        {
          "name": "orientation",
          "type": "\"horizontal\" | \"vertical\"",
          "default": "\"horizontal\""
        },
        {
          "name": "variant",
          "type": "\"default\" | \"outline\""
        },
        {
          "name": "size",
          "type": "\"default\" | \"sm\" | \"lg\""
        },
        {
          "name": "spacing",
          "type": "number",
          "default": "2"
        }
      ],
      "inherits": [
        "HTMLAttributes",
        "PrimitivePropsWithRef",
        "ToggleGroupImplMultipleProps",
        "ToggleGroupImplProps",
        "ToggleGroupMultipleProps"
      ]
    },
    {
      "name": "ToggleGroupItem",
      "props": [
        {
          "name": "variant",
          "type": "\"default\" | \"outline\"",
          "default": "\"default\""
        },
        {
          "name": "size",
          "type": "\"default\" | \"sm\" | \"lg\"",
          "default": "\"default\""
        }
      ],
      "inherits": [
        "ButtonHTMLAttributes",
        "HTMLAttributes",
        "PrimitivePropsWithRef",
        "ToggleGroupItemImplProps"
      ]
    }
  ],
  "examples": [
    {
      "title": "Toggle Group",
      "imports": [
        "import { ToggleGroup, ToggleGroupItem } from \"@/components/ui/toggle-group\"",
        "import { AlignCenterIcon, AlignLeftIcon, AlignRightIcon } from \"lucide-react\""
      ],
      "code": "<ToggleGroup\n  type=\"single\"\n  variant=\"outline\"\n  defaultValue=\"left\"\n  aria-label=\"Text alignment\"\n>\n  <ToggleGroupItem value=\"left\" aria-label=\"Align left\">\n    <AlignLeftIcon />\n  </ToggleGroupItem>\n  <ToggleGroupItem value=\"center\" aria-label=\"Align center\">\n    <AlignCenterIcon />\n  </ToggleGroupItem>\n  <ToggleGroupItem value=\"right\" aria-label=\"Align right\">\n    <AlignRightIcon />\n  </ToggleGroupItem>\n</ToggleGroup>"
    }
  ]
}
