{
  "name": "infinite-scroll",
  "components": [
    {
      "name": "InfiniteScroll",
      "props": [
        {
          "name": "draggable",
          "type": "boolean",
          "default": "true",
          "description": "Lets a mouse drag a sideways row. Touch always swipes."
        },
        {
          "name": "items",
          "type": "readonly T[]"
        },
        {
          "name": "renderItem",
          "type": "((item: T, index: number) => React.ReactNode)"
        },
        {
          "name": "getItemKey",
          "type": "((item: T, index: number) => React.Key)",
          "default": "keyOf",
          "description": "Defaults to the item's `id` or `key` field, then its index."
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "description": "Used instead of `items` when you compose the list yourself."
        },
        {
          "name": "hasMore",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "loading",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "onLoadMore",
          "type": "(() => unknown)"
        },
        {
          "name": "error",
          "type": "React.ReactNode",
          "description": "Shown in place of the loader after a failed load, with a retry."
        },
        {
          "name": "layout",
          "type": "InfiniteScrollLayout",
          "default": "\"list\""
        },
        {
          "name": "columns",
          "type": "number",
          "description": "Fixed column count for `grid` and `masonry`."
        },
        {
          "name": "minItemWidth",
          "type": "number",
          "default": "220",
          "description": "Column width floor (px) that picks the count for `grid` and `masonry`; the column width of a sideways grid."
        },
        {
          "name": "rows",
          "type": "number",
          "default": "2",
          "description": "Row count of a sideways grid."
        },
        {
          "name": "scroll",
          "type": "\"container\" | \"page\"",
          "default": "\"page\""
        },
        {
          "name": "direction",
          "type": "\"right\" | \"left\" | \"up\" | \"down\"",
          "default": "\"down\""
        },
        {
          "name": "snap",
          "type": "boolean",
          "default": "false",
          "description": "Snaps scrolling to the start of each item."
        },
        {
          "name": "trigger",
          "type": "\"button\" | \"auto\"",
          "default": "\"auto\""
        },
        {
          "name": "rootMargin",
          "type": "string",
          "default": "\"320px\"",
          "description": "How far past the scroll edge to start loading, as a CSS margin."
        },
        {
          "name": "loader",
          "type": "React.ReactNode",
          "description": "Replaces the default loading row."
        },
        {
          "name": "end",
          "type": "React.ReactNode",
          "description": "Shown after the last page."
        },
        {
          "name": "empty",
          "type": "React.ReactNode",
          "description": "Shown when there are no items and nothing left to load."
        },
        {
          "name": "contentClassName",
          "type": "string",
          "description": "Class for the element holding the items."
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": []
}
