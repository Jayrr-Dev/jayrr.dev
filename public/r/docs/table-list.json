{
  "name": "table-list",
  "components": [
    {
      "name": "TableList",
      "description": "One list, two views. Renders the same rows as a StandardTable or a StandardGrid behind shared chrome, so search, filters, sort order and page survive a switch between views.",
      "props": [
        {
          "name": "data",
          "type": "T[]",
          "required": true
        },
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "emptyMessage",
          "type": "string",
          "default": "\"No Data\""
        },
        {
          "name": "showSearch",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "searchPlaceholder",
          "type": "string"
        },
        {
          "name": "filterBadge",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "filterSelect",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "showRefresh",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "onRefresh",
          "type": "(() => void)"
        },
        {
          "name": "titleBar",
          "type": "import(\"C:/Users/Work/Projects/jayrr.dev/components/standard/standard-list-chrome\").StandardListTitleBar"
        },
        {
          "name": "errorBar",
          "type": "string"
        },
        {
          "name": "pagination",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "initialPageSize",
          "type": "number",
          "default": "10"
        },
        {
          "name": "columns",
          "type": "import(\"C:/Users/Work/Projects/jayrr.dev/components/standard/standard-table\").StandardTableColumn<T>[]",
          "required": true
        },
        {
          "name": "getRowKey",
          "type": "(item: T, index: number) => string | number",
          "required": true
        },
        {
          "name": "sorting",
          "type": "boolean",
          "default": "true"
        },
        {
          "name": "density",
          "type": "import(\"C:/Users/Work/Projects/jayrr.dev/components/standard/standard-table\").StandardTableDensity",
          "default": "\"default\"",
          "description": "Row height and padding."
        },
        {
          "name": "striped",
          "type": "boolean",
          "default": "false",
          "description": "Shades every other row."
        },
        {
          "name": "bordered",
          "type": "boolean",
          "default": "false",
          "description": "Adds lines between columns."
        },
        {
          "name": "stickyFirstColumn",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "rowActions",
          "type": "((item: T, index: number) => import(\"C:/Users/Work/Projects/jayrr.dev/components/standard/standard-table\").StandardTableAction[])",
          "description": "Per-row menu in a trailing actions column."
        },
        {
          "name": "bulkActions",
          "type": "((visibleRows: T[]) => import(\"C:/Users/Work/Projects/jayrr.dev/components/standard/standard-table\").StandardTableAction[])",
          "description": "Header menu for the actions column; receives the currently visible (filtered + paged) rows."
        },
        {
          "name": "getRowLabel",
          "type": "((item: T, index: number) => string)"
        },
        {
          "name": "gap",
          "type": "\"xs\" | \"sm\" | \"lg\" | \"md\"",
          "default": "\"md\"",
          "description": "`xs` packs tiles edge to edge, for media grids."
        },
        {
          "name": "renderCard",
          "type": "(item: T, index: number) => React.ReactNode",
          "required": true
        },
        {
          "name": "skipCardWrapper",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "view",
          "type": "TableListView",
          "description": "Controlled view."
        },
        {
          "name": "defaultView",
          "type": "TableListView",
          "default": "\"table\""
        },
        {
          "name": "onViewChange",
          "type": "((view: TableListView) => void)"
        },
        {
          "name": "viewSwitcher",
          "type": "boolean",
          "default": "false",
          "description": "Adds a table / grid toggle to the title bar."
        },
        {
          "name": "gridColumns",
          "type": "import(\"C:/Users/Work/Projects/jayrr.dev/components/standard/standard-grid\").StandardGridColumnConfig",
          "description": "Grid columns per breakpoint (`columns` holds the table columns)."
        },
        {
          "name": "filters",
          "type": "StandardListFilter[]",
          "default": "[]",
          "description": "Filters beyond the ones declared on `columns`."
        }
      ]
    }
  ],
  "examples": []
}
