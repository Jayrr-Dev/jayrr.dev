{
  "name": "heart",
  "components": [
    {
      "name": "Heart",
      "description": "A like toggle. Liking fills the heart and plays one of several effects: a burst of dots, a pop, a heartbeat, floating hearts or a liquid fill. Unliking can play one too: the heart breaks in two, deflates, falls or drains empty. Effects only play on a click, never on mount, and honour reduced motion.",
      "props": [
        {
          "name": "pressed",
          "type": "boolean"
        },
        {
          "name": "defaultPressed",
          "type": "boolean"
        },
        {
          "name": "onPressedChange",
          "type": "((pressed: boolean) => void)"
        },
        {
          "name": "effect",
          "type": "HeartEffect",
          "default": "\"burst\"",
          "description": "The animation played when the heart is liked."
        },
        {
          "name": "unlikeEffect",
          "type": "HeartUnlikeEffect",
          "default": "\"none\"",
          "description": "The animation played when the like is taken back."
        },
        {
          "name": "size",
          "type": "HeartSize",
          "default": "\"default\""
        },
        {
          "name": "count",
          "type": "number",
          "description": "Count shown beside the icon."
        }
      ],
      "inherits": [
        "ButtonHTMLAttributes",
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "imports": [
        "import { Heart } from \"@/components/standard/heart\""
      ],
      "code": "<Heart defaultPressed unlikeEffect={unlikeEffect} size=\"lg\" />"
    },
    {
      "title": "count · controlled",
      "imports": [
        "import { Heart } from \"@/components/standard/heart\""
      ],
      "setup": "const BASE_COUNT = 241",
      "code": "<Heart\n  pressed={liked}\n  onPressedChange={setLiked}\n  count={BASE_COUNT + (liked ? 1 : 0)}\n/>"
    },
    {
      "imports": [
        "import { Heart } from \"@/components/standard/heart\""
      ],
      "code": "<Heart effect={effect} size=\"lg\" />"
    },
    {
      "title": "disabled",
      "imports": [
        "import { Heart } from \"@/components/standard/heart\""
      ],
      "code": "<Heart disabled defaultPressed />"
    }
  ]
}
