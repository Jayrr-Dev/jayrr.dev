{
  "name": "time-picker",
  "components": [
    {
      "name": "TimePicker",
      "description": "Field that opens a Material 3 style time picker. Changes stay a draft until OK; Cancel or Escape throws them away.",
      "props": [
        {
          "name": "value",
          "type": "string",
          "description": "\"HH:mm\", 24-hour. null or \"\" shows the placeholder."
        },
        {
          "name": "defaultValue",
          "type": "string"
        },
        {
          "name": "onValueChange",
          "type": "((value: string) => void)",
          "description": "Fires with \"HH:mm\" when OK is pressed."
        },
        {
          "name": "hourCycle",
          "type": "HourCycle",
          "default": "12"
        },
        {
          "name": "minuteStep",
          "type": "number",
          "default": "1"
        },
        {
          "name": "defaultMode",
          "type": "TimePickerMode",
          "default": "\"dial\""
        },
        {
          "name": "orientation",
          "type": "\"horizontal\" | \"vertical\"",
          "default": "\"vertical\""
        },
        {
          "name": "placeholder",
          "type": "string",
          "default": "\"Select time\""
        },
        {
          "name": "invalid",
          "type": "boolean",
          "description": "Shows the error style. Same as passing aria-invalid."
        },
        {
          "name": "align",
          "type": "\"center\" | \"start\" | \"end\"",
          "default": "\"start\""
        }
      ],
      "inherits": [
        "ButtonHTMLAttributes",
        "HTMLAttributes"
      ]
    },
    {
      "name": "TimePickerPanel",
      "description": "Material 3 style time picker, laid out inline: time fields, AM/PM, a dial you can click or drag, and a keyboard entry mode.",
      "props": [
        {
          "name": "value",
          "type": "string",
          "description": "\"HH:mm\", 24-hour. Leave undefined to let the panel hold its own value."
        },
        {
          "name": "defaultValue",
          "type": "string"
        },
        {
          "name": "onValueChange",
          "type": "((value: string) => void)"
        },
        {
          "name": "hourCycle",
          "type": "HourCycle",
          "default": "12",
          "description": "12 shows an AM/PM toggle; 24 adds an inner ring for 12–23."
        },
        {
          "name": "minuteStep",
          "type": "number",
          "default": "1",
          "description": "Minutes the dial snaps to. Typed minutes are not snapped."
        },
        {
          "name": "mode",
          "type": "TimePickerMode"
        },
        {
          "name": "defaultMode",
          "type": "TimePickerMode",
          "default": "\"dial\""
        },
        {
          "name": "onModeChange",
          "type": "((mode: TimePickerMode) => void)"
        },
        {
          "name": "orientation",
          "type": "\"horizontal\" | \"vertical\"",
          "default": "\"vertical\"",
          "description": "Vertical stacks the dial under the time; horizontal puts it beside."
        },
        {
          "name": "headline",
          "type": "React.ReactNode",
          "description": "Overrides \"Select time\" / \"Enter time\"."
        },
        {
          "name": "actions",
          "type": "React.ReactNode",
          "description": "Sits right of the keyboard/clock toggle, e.g. Cancel and OK."
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "imports": [
        "import { TimePicker } from \"@/components/standard/time-picker\""
      ],
      "code": "<TimePicker\n  aria-label=\"Start time\"\n  value={time}\n  onValueChange={setTime}\n  className=\"w-40\"\n/>"
    },
    {
      "imports": [
        "import { TimePickerPanel } from \"@/components/standard/time-picker\""
      ],
      "code": "<div className=\"w-max rounded-2xl border border-border\">\n  <TimePickerPanel value={panelTime} onValueChange={setPanelTime} />\n</div>"
    },
    {
      "title": "24-hour · 5 min steps · empty",
      "imports": [
        "import { TimePicker } from \"@/components/standard/time-picker\""
      ],
      "code": "<TimePicker\n  aria-label=\"End time\"\n  hourCycle={24}\n  minuteStep={5}\n  className=\"w-40\"\n/>"
    },
    {
      "title": "invalid",
      "imports": [
        "import { TimePicker } from \"@/components/standard/time-picker\""
      ],
      "code": "<TimePicker aria-label=\"Pickup time\" invalid className=\"w-40\" />"
    }
  ]
}
