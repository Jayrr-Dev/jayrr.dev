{
  "name": "page-header",
  "components": [
    {
      "name": "PageHeader",
      "props": [
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "name": "info",
          "type": "string"
        },
        {
          "name": "backLabel",
          "type": "string"
        },
        {
          "name": "onBack",
          "type": "(() => void)"
        },
        {
          "name": "children",
          "type": "React.ReactNode"
        }
      ]
    }
  ],
  "examples": [
    {
      "imports": [
        "import { PageHeader } from \"@/components/standard/page-header\"",
        "import { RefreshButton } from \"@/components/standard/refresh-button\""
      ],
      "code": "<PageHeader\n  title=\"Timesheets\"\n  info=\"Hours for the open period.\"\n  backLabel=\"Back\"\n>\n  <RefreshButton />\n</PageHeader>"
    },
    {
      "title": "with action",
      "imports": [
        "import { Button } from \"@/components/standard/button\"",
        "import { PageHeader } from \"@/components/standard/page-header\""
      ],
      "code": "<PageHeader title=\"Jobs\">\n  <Button size=\"sm\">New</Button>\n</PageHeader>"
    }
  ]
}
