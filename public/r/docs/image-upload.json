{
  "name": "image-upload",
  "components": [
    {
      "name": "ImageUpload",
      "props": [
        {
          "name": "label",
          "type": "string",
          "default": "\"Image\""
        },
        {
          "name": "hint",
          "type": "string"
        },
        {
          "name": "variant",
          "type": "ImageUploadVariant",
          "default": "\"dropzone\""
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "maxSizeMb",
          "type": "number",
          "default": "5"
        },
        {
          "name": "progress",
          "type": "number",
          "description": "Upload progress from 0 to 100. Shows a progress bar while set."
        },
        {
          "name": "defaultPreview",
          "type": "string"
        },
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "onFileChange",
          "type": "((file: File | null) => void)"
        }
      ]
    }
  ],
  "examples": [
    {
      "title": "Avatar",
      "imports": [
        "import { ImageUpload } from \"@/components/standard/image-upload\""
      ],
      "code": "<ImageUpload label=\"Profile photo\" variant=\"avatar\" maxSizeMb={2} />"
    },
    {
      "title": "Uploading",
      "imports": [
        "import { ImageUpload } from \"@/components/standard/image-upload\""
      ],
      "setup": "const SAMPLE_IMAGE = `data:image/svg+xml;utf8,${encodeURIComponent(\n  `<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 96 96\"><defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#6366f1\"/><stop offset=\"1\" stop-color=\"#ec4899\"/></linearGradient></defs><rect width=\"96\" height=\"96\" fill=\"url(#g)\"/><circle cx=\"68\" cy=\"30\" r=\"10\" fill=\"#fde68a\"/><path d=\"M0 80 L32 48 L56 70 L72 56 L96 78 V96 H0Z\" fill=\"#1e1b4b\" opacity=\".55\"/></svg>`\n)}`",
      "code": "<ImageUpload\n  label=\"Cover image\"\n  defaultPreview={SAMPLE_IMAGE}\n  progress={progress}\n/>"
    },
    {
      "title": "Disabled",
      "imports": [
        "import { ImageUpload } from \"@/components/standard/image-upload\""
      ],
      "code": "<ImageUpload label=\"Cover image\" disabled />"
    },
    {
      "title": "Dropzone",
      "imports": [
        "import { ImageUpload } from \"@/components/standard/image-upload\""
      ],
      "code": "<ImageUpload label=\"Cover image\" />"
    }
  ]
}
