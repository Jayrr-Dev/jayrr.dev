{
  "name": "character-chat",
  "components": [
    {
      "name": "CharacterChat",
      "props": [
        {
          "name": "lines",
          "type": "CharacterChatLine[]",
          "required": true
        },
        {
          "name": "index",
          "type": "number",
          "description": "The line on show. Pass it to control the box; leave it out otherwise."
        },
        {
          "name": "defaultIndex",
          "type": "number",
          "default": "0"
        },
        {
          "name": "onIndexChange",
          "type": "((index: number) => void)"
        },
        {
          "name": "onComplete",
          "type": "(() => void)",
          "description": "Fires when the reader advances past the last line."
        },
        {
          "name": "variant",
          "type": "CharacterChatVariant",
          "default": "\"default\""
        },
        {
          "name": "size",
          "type": "\"default\" | \"sm\" | \"lg\"",
          "default": "\"default\""
        },
        {
          "name": "speed",
          "type": "number",
          "default": "45",
          "description": "Characters a second. 0 shows each line at once."
        },
        {
          "name": "autoAdvance",
          "type": "number",
          "description": "Move on by itself this many ms after a line finishes."
        },
        {
          "name": "thinking",
          "type": "boolean",
          "default": "false",
          "description": "Show bouncing dots in place of the line, while it's being written."
        },
        {
          "name": "indicator",
          "type": "CharacterChatIndicator",
          "description": "The \"continue\" mark once a line is done. Each variant has its own default."
        },
        {
          "name": "trailing",
          "type": "React.ReactNode",
          "description": "Controls beside the box, like save, replay or history buttons."
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "variants",
      "imports": [
        "import { CharacterChat } from \"@/components/standard/character-chat\""
      ],
      "setup": "const variants: CharacterChatVariant[] = [\n  \"default\",\n  \"classic\",\n  \"soft\",\n  \"tab\",\n  \"frame\",\n  \"minimal\",\n]",
      "code": "<div className=\"grid w-full gap-6 rounded-lg bg-[linear-gradient(160deg,#58627d,#262b3d)] p-4 pt-6\">\n  {variants.map((variant) => (\n    <CharacterChat\n      key={variant}\n      variant={variant}\n      size=\"sm\"\n      speed={0}\n      lines={[\n        {\n          speaker: variant === \"classic\" ? \"Narrator\" : \"Mira\",\n          text:\n            variant === \"classic\"\n              ? \"I have a feeling he unironically quotes film villains.\"\n              : `This is the ${variant} box. *Click* me to see the next line mark.`,\n        },\n      ]}\n    />\n  ))}\n</div>"
    },
    {
      "title": "thinking",
      "imports": [
        "import { CharacterChat } from \"@/components/standard/character-chat\""
      ],
      "setup": "const mira = <RendersBust hair=\"#3b2a4a\" shirt=\"#6b4f8a\" />",
      "code": "<CharacterChat\n  thinking\n  lines={[{ speaker: \"Mira\", portrait: mira, text: \"\" }]}\n/>"
    }
  ]
}
