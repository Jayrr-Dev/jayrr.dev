{
  "name": "standard-input-otp",
  "components": [
    {
      "name": "InputOtp",
      "props": [
        {
          "name": "length",
          "type": "number",
          "default": "6"
        },
        {
          "name": "invalid",
          "type": "boolean",
          "description": "Shows the error style. Same as passing aria-invalid."
        }
      ],
      "inherits": [
        "HTMLAttributes",
        "InputHTMLAttributes",
        "OTPInputBaseProps"
      ]
    }
  ],
  "examples": [
    {
      "title": "invalid",
      "imports": [
        "import { InputOtp } from \"@/components/standard/input-otp\""
      ],
      "code": "<InputOtp invalid defaultValue=\"123\" />"
    },
    {
      "title": "Input otp",
      "imports": [
        "import { InputOtp } from \"@/components/standard/input-otp\""
      ],
      "code": "<InputOtp />"
    }
  ]
}
