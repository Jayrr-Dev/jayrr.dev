{
  "name": "ring-wave",
  "components": [
    {
      "name": "RingWave",
      "props": [
        {
          "name": "rings",
          "type": "number",
          "default": "8",
          "description": "How many rings. With `value`, there is one ring per entry."
        },
        {
          "name": "pattern",
          "type": "\"orbit\" | \"ripple\" | \"spectrum\" | \"cascade\" | \"grow\"",
          "default": "\"grow\"",
          "description": "What drives the arcs. Ignored with `value`."
        },
        {
          "name": "value",
          "type": "number[]",
          "description": "Controls each ring's sweep directly, inner ring first, each from 0 to 1."
        },
        {
          "name": "full",
          "type": "boolean",
          "default": "false",
          "description": "Draws every ring as a whole circle; the pattern drives brightness and thickness instead of sweep."
        },
        {
          "name": "kind",
          "type": "\"ticks\" | \"segments\" | \"solid\"",
          "description": "Gives every ring this kind, such as `solid` for plain rings; `layout` still wins per ring."
        },
        {
          "name": "weight",
          "type": "number",
          "description": "Gives every ring this thickness, from 0 to 1 of its band; `1` with `gap={0}` packs rings edge to edge."
        },
        {
          "name": "fit",
          "type": "\"cover\" | \"contain\"",
          "default": "\"contain\""
        },
        {
          "name": "layout",
          "type": "RingWaveRing[]",
          "description": "Sets rings' looks, inner ring first; missing rings and fields come from `seed`."
        },
        {
          "name": "seed",
          "type": "number",
          "default": "1",
          "description": "Picks the rings' kinds, weights and speeds; the same seed draws the same rings."
        },
        {
          "name": "radius",
          "type": "number",
          "default": "0.22",
          "description": "Radius of the empty middle, as a fraction of the whole."
        },
        {
          "name": "gap",
          "type": "number",
          "default": "0.3",
          "description": "Space between rings, as a fraction of each ring's band; 0 packs them edge to edge."
        },
        {
          "name": "track",
          "type": "boolean",
          "default": "true",
          "description": "A faint full circle behind each arc."
        },
        {
          "name": "rounded",
          "type": "boolean",
          "default": "false",
          "description": "Round the ends of solid arcs."
        },
        {
          "name": "spin",
          "type": "number",
          "default": "1",
          "description": "Scales how fast the rings turn; 0 holds them still."
        },
        {
          "name": "speed",
          "type": "number",
          "default": "1",
          "description": "Scales how fast the arcs grow and shrink."
        },
        {
          "name": "smoothing",
          "type": "number",
          "default": "0.2",
          "description": "From 0 (arcs jump to each new sweep) to 1 (arcs glide slowly toward it)."
        },
        {
          "name": "color",
          "type": "string",
          "description": "Ring color; any CSS color, including `var(--token)`. Defaults to the text color."
        },
        {
          "name": "colors",
          "type": "string[]",
          "description": "Gradient stops, inner ring first; any CSS colors. Wins over `palette`."
        },
        {
          "name": "palette",
          "type": "\"ocean\" | \"aurora\" | \"sunset\" | \"ember\" | \"neon\" | \"hud\""
        },
        {
          "name": "gradient",
          "type": "\"ring\" | \"sweep\"",
          "default": "\"ring\""
        },
        {
          "name": "glow",
          "type": "boolean",
          "default": "false",
          "description": "A soft halo around the arcs."
        },
        {
          "name": "intro",
          "type": "boolean",
          "default": "true",
          "description": "Arcs grow from a point on start, inner rings first."
        },
        {
          "name": "paused",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "label",
          "type": "string",
          "description": "Accessible description; defaults to the pattern name."
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "no gap · rings packed edge to edge",
      "imports": [
        "import { RingWave } from \"@/components/standard/ring-wave\""
      ],
      "code": "<div className=\"flex w-full flex-col gap-4\">\n  <div className=\"relative h-64 w-full overflow-hidden rounded-xl bg-background\">\n    <RingWave\n      full\n      pattern=\"ripple\"\n      kind=\"solid\"\n      weight={1}\n      gap={0}\n      fit=\"cover\"\n      rings={48}\n      radius={0}\n      spin={0}\n      palette=\"ocean\"\n      className=\"absolute inset-0 size-full\"\n    />\n  </div>\n  <div className=\"grid w-full grid-cols-2 place-items-center gap-4 sm:grid-cols-4\">\n    <RingWave\n      full\n      pattern=\"ripple\"\n      kind=\"solid\"\n      weight={1}\n      gap={0}\n      rings={20}\n      radius={0}\n      spin={0}\n      className=\"size-36\"\n    />\n    <RingWave\n      pattern=\"grow\"\n      kind=\"solid\"\n      weight={1}\n      gap={0}\n      rings={14}\n      track={false}\n      palette=\"sunset\"\n      className=\"size-36\"\n    />\n    <RingWave\n      pattern=\"cascade\"\n      kind=\"segments\"\n      weight={1}\n      gap={0}\n      rings={10}\n      seed={3}\n      palette=\"aurora\"\n      className=\"size-36\"\n    />\n    <RingWave\n      full\n      pattern=\"spectrum\"\n      kind=\"solid\"\n      weight={1}\n      gap={0}\n      rings={16}\n      radius={0.15}\n      palette=\"neon\"\n      gradient=\"sweep\"\n      className=\"size-36\"\n    />\n  </div>\n</div>"
    },
    {
      "title": "variants",
      "imports": [
        "import { RingWave } from \"@/components/standard/ring-wave\""
      ],
      "code": "<div className=\"grid w-full grid-cols-2 place-items-center gap-4 sm:grid-cols-4\">\n  <RingWave seed={3} palette=\"hud\" glow className=\"size-36\" />\n  <RingWave\n    pattern=\"cascade\"\n    rings={10}\n    seed={5}\n    className=\"size-36\"\n  />\n  <RingWave\n    pattern=\"spectrum\"\n    rings={14}\n    seed={9}\n    palette=\"neon\"\n    gradient=\"sweep\"\n    glow\n    className=\"size-36\"\n  />\n  <RendersGauge />\n  <RingWave\n    pattern=\"orbit\"\n    rings={6}\n    seed={2}\n    palette=\"ocean\"\n    spin={2}\n    className=\"size-36\"\n  />\n  <RingWave\n    pattern=\"grow\"\n    rings={20}\n    seed={12}\n    gap={0.15}\n    track={false}\n    palette=\"ember\"\n    className=\"size-36\"\n  />\n  <RingWave\n    pattern=\"cascade\"\n    rings={6}\n    seed={4}\n    layout={Array.from({ length: 6 }, () => ({\n      kind: \"solid\" as const,\n      weight: 1,\n    }))}\n    rounded\n    palette=\"aurora\"\n    className=\"size-36\"\n  />\n  <RingWave\n    pattern=\"orbit\"\n    rings={9}\n    seed={21}\n    layout={Array.from({ length: 9 }, () => ({\n      kind: \"ticks\" as const,\n    }))}\n    radius={0.1}\n    spin={3}\n    palette=\"sunset\"\n    gradient=\"sweep\"\n    className=\"size-36\"\n  />\n</div>"
    },
    {
      "title": "full card · a ripple from the center",
      "imports": [
        "import { RingWave } from \"@/components/standard/ring-wave\""
      ],
      "code": "<div className=\"relative h-80 w-full overflow-hidden rounded-xl bg-background\">\n  <RingWave\n    full\n    pattern=\"ripple\"\n    kind=\"solid\"\n    fit=\"cover\"\n    rings={36}\n    radius={0}\n    gap={0.2}\n    spin={0}\n    palette=\"hud\"\n    glow\n    className=\"absolute inset-0 size-full\"\n  />\n</div>"
    },
    {
      "title": "full rings · the wave as brightness",
      "imports": [
        "import { RingWave } from \"@/components/standard/ring-wave\""
      ],
      "code": "<div className=\"grid w-full grid-cols-2 place-items-center gap-4 sm:grid-cols-4\">\n  <RingWave\n    full\n    pattern=\"ripple\"\n    kind=\"solid\"\n    rings={16}\n    radius={0.05}\n    spin={0}\n    className=\"size-36\"\n  />\n  <RingWave\n    full\n    pattern=\"ripple\"\n    kind=\"segments\"\n    rings={12}\n    seed={4}\n    palette=\"ocean\"\n    className=\"size-36\"\n  />\n  <RingWave\n    full\n    pattern=\"grow\"\n    kind=\"ticks\"\n    rings={10}\n    seed={8}\n    palette=\"neon\"\n    gradient=\"sweep\"\n    glow\n    className=\"size-36\"\n  />\n  <RingWave\n    full\n    pattern=\"spectrum\"\n    rings={14}\n    seed={6}\n    palette=\"ember\"\n    className=\"size-36\"\n  />\n</div>"
    }
  ]
}
