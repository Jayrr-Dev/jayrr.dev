{
  "name": "choice-label",
  "components": [
    {
      "name": "ChoiceLabel",
      "description": "The clickable label, and optional description, shared by Checkbox and Radio. Internal: reach for those components instead.",
      "props": [
        {
          "name": "size",
          "type": "\"default\" | \"sm\"",
          "default": "\"default\""
        },
        {
          "name": "appearance",
          "type": "\"default\" | \"card\"",
          "default": "\"default\""
        },
        {
          "name": "slot",
          "type": "string",
          "required": true,
          "description": "data-slot for the label, e.g. \"checkbox-label\"."
        },
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "control",
          "type": "React.ReactNode",
          "required": true,
          "description": "The input the label wraps."
        },
        {
          "name": "label",
          "type": "React.ReactNode",
          "required": true
        },
        {
          "name": "description",
          "type": "React.ReactNode"
        }
      ]
    }
  ],
  "examples": []
}
