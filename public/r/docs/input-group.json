{
  "name": "input-group",
  "components": [
    {
      "name": "InputGroup",
      "props": [],
      "inherits": [
        "HTMLAttributes"
      ]
    },
    {
      "name": "InputGroupAddon",
      "props": [
        {
          "name": "align",
          "type": "\"inline-start\" | \"inline-end\" | \"block-start\" | \"block-end\"",
          "default": "\"inline-start\""
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    },
    {
      "name": "InputGroupButton",
      "props": [
        {
          "name": "asChild",
          "type": "boolean"
        },
        {
          "name": "variant",
          "type": "\"link\" | \"default\" | \"outline\" | \"secondary\" | \"ghost\" | \"destructive\"",
          "default": "\"ghost\""
        },
        {
          "name": "size",
          "type": "\"xs\" | \"sm\" | \"icon-xs\" | \"icon-sm\"",
          "default": "\"xs\""
        }
      ],
      "inherits": [
        "ButtonHTMLAttributes",
        "HTMLAttributes"
      ]
    },
    {
      "name": "InputGroupText",
      "props": [],
      "inherits": [
        "HTMLAttributes"
      ]
    },
    {
      "name": "InputGroupInput",
      "props": [],
      "inherits": [
        "HTMLAttributes",
        "InputHTMLAttributes"
      ]
    },
    {
      "name": "InputGroupTextarea",
      "props": [],
      "inherits": [
        "HTMLAttributes",
        "TextareaHTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "Input Group",
      "imports": [
        "import { InputGroup, InputGroupAddon, InputGroupInput } from \"@/components/ui/input-group\""
      ],
      "code": "<InputGroup>\n  <InputGroupAddon>https://</InputGroupAddon>\n  <InputGroupInput placeholder=\"jayrr.dev\" />\n</InputGroup>"
    },
    {
      "title": "Input Group",
      "imports": [
        "import { RendersDemoCard } from \"./rendersDemoCard\"",
        "import { InputGroup, InputGroupAddon, InputGroupInput } from \"@/components/ui/input-group\""
      ],
      "setup": "function TypeCard({\n  label,\n  children,\n  wide,\n}: {\n  label: string\n  children: ReactNode\n  wide?: boolean\n}) {\n  let className: string | undefined\n\n  if (wide) {\n    className = \"w-full max-w-xl\"\n  }\n\n  return (\n    <RendersDemoCard className={className} label={label}>\n      {children}\n    </RendersDemoCard>\n  )\n}",
      "code": "<TypeCard label=\"align inline-end\" wide>\n  <InputGroup>\n    <InputGroupInput placeholder=\"Search\" />\n    <InputGroupAddon align=\"inline-end\">Go</InputGroupAddon>\n  </InputGroup>\n</TypeCard>"
    }
  ]
}
