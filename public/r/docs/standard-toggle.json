{
  "name": "standard-toggle",
  "components": [
    {
      "name": "Toggle",
      "description": "Two-state button. Controlled with `pressed`, or keeps its own state seeded by `defaultPressed`. Icon-only toggles take an `aria-label`.",
      "props": [
        {
          "name": "size",
          "type": "\"default\" | \"sm\" | \"lg\"",
          "default": "\"default\""
        },
        {
          "name": "tone",
          "type": "\"outline\" | \"ghost\"",
          "default": "\"outline\""
        },
        {
          "name": "shape",
          "type": "\"circle\" | \"default\" | \"square\"",
          "default": "\"default\""
        },
        {
          "name": "pressed",
          "type": "boolean"
        },
        {
          "name": "defaultPressed",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "onPressedChange",
          "type": "((pressed: boolean) => void)"
        },
        {
          "name": "iconOnly",
          "type": "boolean",
          "default": "false",
          "description": "Square toggle that holds only an icon; give it an `aria-label`."
        }
      ],
      "inherits": [
        "ButtonHTMLAttributes",
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "tone ghost",
      "imports": [
        "import { Toggle } from \"@/components/standard/toggle\"",
        "import { BoldIcon, ItalicIcon } from \"lucide-react\""
      ],
      "code": "<div className=\"flex flex-wrap items-center gap-1\">\n  <Toggle tone=\"ghost\" iconOnly aria-label=\"Bold\" defaultPressed>\n    <BoldIcon className=\"size-4\" />\n  </Toggle>\n  <Toggle tone=\"ghost\" iconOnly aria-label=\"Italic\">\n    <ItalicIcon className=\"size-4\" />\n  </Toggle>\n</div>"
    },
    {
      "title": "disabled",
      "imports": [
        "import { Toggle } from \"@/components/standard/toggle\""
      ],
      "code": "<Toggle disabled>Locked</Toggle>"
    },
    {
      "title": "size sm",
      "imports": [
        "import { Toggle } from \"@/components/standard/toggle\""
      ],
      "code": "<Toggle size=\"sm\">Small</Toggle>"
    },
    {
      "title": "iconOnly shape circle",
      "imports": [
        "import { Toggle } from \"@/components/standard/toggle\"",
        "import { StarIcon } from \"lucide-react\""
      ],
      "code": "<Toggle iconOnly shape=\"circle\" aria-label=\"Favorite\">\n  <StarIcon className=\"size-4\" />\n</Toggle>"
    }
  ]
}
