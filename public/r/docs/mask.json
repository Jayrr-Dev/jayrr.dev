{
  "name": "mask",
  "components": [
    {
      "name": "Mask",
      "description": "Hides parts of its children with a soft alpha ramp. Give it a `placement` to wrap other layers as one masked layer group.",
      "props": [
        {
          "name": "placement",
          "type": "import(\"C:/Users/Work/Projects/jayrr.dev/components/standard/layer\").LayerPlacement"
        },
        {
          "name": "blend",
          "type": "import(\"C:/Users/Work/Projects/jayrr.dev/components/standard/layer\").LayerBlend"
        },
        {
          "name": "opacity",
          "type": "number",
          "description": "0–1."
        },
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "style",
          "type": "React.CSSProperties"
        },
        {
          "name": "kind",
          "type": "\"fade\" | \"spotlight\" | \"vignette\" | \"edges\"",
          "default": "\"fade\""
        },
        {
          "name": "direction",
          "type": "MaskDirection",
          "default": "\"bottom\"",
          "description": "Which side fades out, for `fade`."
        },
        {
          "name": "softness",
          "type": "number",
          "default": "50",
          "description": "0–100. How much of the box the fade takes."
        },
        {
          "name": "at",
          "type": "string",
          "default": "\"50% 50%\"",
          "description": "Center for `vignette` and `spotlight`, e.g. \"50% 30%\"."
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": true
        }
      ]
    }
  ],
  "examples": []
}
