{
  "name": "standard-progress",
  "components": [
    {
      "name": "Progress",
      "props": [
        {
          "name": "size",
          "type": "\"default\" | \"xs\" | \"sm\" | \"lg\" | \"xl\"",
          "default": "\"default\""
        },
        {
          "name": "tone",
          "type": "\"default\" | \"success\" | \"warning\" | \"danger\"",
          "default": "\"default\""
        },
        {
          "name": "value",
          "type": "number",
          "default": "0"
        },
        {
          "name": "max",
          "type": "number",
          "default": "100"
        },
        {
          "name": "segments",
          "type": "ProgressSegment[]",
          "description": "Several coloured parts in one bar. `value` is ignored."
        },
        {
          "name": "indeterminate",
          "type": "boolean",
          "default": "false",
          "description": "Unknown duration: a bar sweeps back and forth."
        },
        {
          "name": "label",
          "type": "React.ReactNode",
          "description": "Text above the bar, left."
        },
        {
          "name": "showValue",
          "type": "boolean",
          "default": "false",
          "description": "Shows the percentage above the bar, right."
        },
        {
          "name": "ticker",
          "type": "boolean",
          "default": "false",
          "description": "Counts the percentage up to `value` (from 0 on mount, then from the last value) and fills the bar in step. Turns `showValue` on."
        },
        {
          "name": "showSegmentValues",
          "type": "boolean",
          "default": "false",
          "description": "Prints each segment's percentage inside its slice. Best at `size=\"xl\"`."
        }
      ],
      "inherits": [
        "HTMLAttributes",
        "PrimitivePropsWithRef",
        "ProgressProps"
      ]
    }
  ],
  "examples": [
    {
      "title": "label · showValue",
      "imports": [
        "import { Progress } from \"@/components/standard/progress\""
      ],
      "code": "<Progress value={64} label=\"Hours logged\" showValue />"
    },
    {
      "title": "segments · showSegmentValues",
      "imports": [
        "import { Progress } from \"@/components/standard/progress\""
      ],
      "code": "<Progress\n  size=\"xl\"\n  showSegmentValues\n  segments={[\n    { id: \"billable\", value: 45 },\n    { id: \"overtime\", value: 15, tone: \"warning\" },\n    { id: \"leave\", value: 10, className: \"bg-muted-foreground/50\" },\n  ]}\n/>"
    },
    {
      "title": "indeterminate",
      "imports": [
        "import { Progress } from \"@/components/standard/progress\""
      ],
      "code": "<Progress indeterminate aria-label=\"Syncing\" />"
    },
    {
      "imports": [
        "import { Progress } from \"@/components/standard/progress\""
      ],
      "code": "<Progress value={25} className=\"w-full\" />"
    }
  ]
}
