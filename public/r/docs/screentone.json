{
  "name": "screentone",
  "components": [
    {
      "name": "Screentone",
      "description": "Manga-style halftone tone. Dots, lines, crosshatch, diamonds, rings or noise that grow with a graded or organic density.",
      "props": [
        {
          "name": "placement",
          "type": "import(\"C:/Users/Work/Projects/jayrr.dev/components/standard/layer\").LayerPlacement"
        },
        {
          "name": "blend",
          "type": "import(\"C:/Users/Work/Projects/jayrr.dev/components/standard/layer\").LayerBlend"
        },
        {
          "name": "opacity",
          "type": "number",
          "description": "0–1."
        },
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "style",
          "type": "React.CSSProperties"
        },
        {
          "name": "kind",
          "type": "\"dots\" | \"lines\" | \"diamonds\" | \"crosshatch\" | \"rings\" | \"noise\"",
          "default": "\"dots\""
        },
        {
          "name": "tone",
          "type": "\"flat\" | \"center\" | \"top\" | \"bottom\" | \"right\" | \"left\" | \"edges\" | \"clouds\" | \"corner\" | \"folds\" | \"marble\" | \"streaks\"",
          "default": "\"bottom\""
        },
        {
          "name": "density",
          "type": "[number, number]",
          "description": "0–1 ink coverage as [dense, light]. `flat` uses the first value; organic tones spread between the two."
        },
        {
          "name": "size",
          "type": "number",
          "description": "Screen cell in px."
        },
        {
          "name": "angle",
          "type": "number",
          "description": "Screen rotation in degrees."
        },
        {
          "name": "at",
          "type": "string",
          "default": "\"50% 50%\"",
          "description": "Center for `rings` and `center`, e.g. \"50% 50%\"."
        },
        {
          "name": "seed",
          "type": "number",
          "default": "1",
          "description": "Varies organic tones and grit."
        },
        {
          "name": "rough",
          "type": "boolean",
          "default": "false",
          "description": "Chewed, printed dot edges."
        },
        {
          "name": "color",
          "type": "string",
          "default": "\"color-mix(in oklch, var(--foreground) 32%, transparent)\"",
          "description": "Any CSS color. Defaults to a faint foreground."
        }
      ]
    }
  ],
  "examples": []
}
