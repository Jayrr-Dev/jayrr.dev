{
  "name": "loading-state",
  "components": [
    {
      "name": "LoadingState",
      "props": [
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "label",
          "type": "string",
          "default": "\"Loading\""
        },
        {
          "name": "done",
          "type": "boolean",
          "default": "false",
          "description": "Shows a check and `doneLabel` in place of the spinner."
        },
        {
          "name": "doneLabel",
          "type": "string",
          "default": "\"Done\""
        },
        {
          "name": "doneDismissAfter",
          "type": "number",
          "description": "When done, fades the check out after this many ms; the label stays."
        },
        {
          "name": "layout",
          "type": "\"inline\" | \"overlay\" | \"block\"",
          "default": "\"inline\""
        }
      ]
    },
    {
      "name": "Spinner",
      "props": [
        {
          "name": "variant",
          "type": "import(\"C:/Users/Work/Projects/jayrr.dev/components/ui/spinner\").SpinnerVariant",
          "default": "\"ring\""
        }
      ],
      "inherits": [
        "SVGAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "done",
      "imports": [
        "import { LoadingState } from \"@/components/standard/loading-state\""
      ],
      "code": "<LoadingState done doneLabel=\"Jobs loaded\" />"
    },
    {
      "title": "layout block",
      "imports": [
        "import { LoadingState } from \"@/components/standard/loading-state\""
      ],
      "code": "<div className=\"w-full rounded-lg border border-border\">\n  <LoadingState layout=\"block\" label=\"Loading jobs\" />\n</div>"
    }
  ]
}
