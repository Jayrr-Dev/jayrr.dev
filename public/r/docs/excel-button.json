{
  "name": "excel-button",
  "components": [
    {
      "name": "ExcelButton",
      "props": [
        {
          "name": "rel",
          "type": "string"
        },
        {
          "name": "size",
          "type": "\"default\" | \"xs\" | \"sm\" | \"lg\""
        },
        {
          "name": "loading",
          "type": "boolean | \"spin-icon\"",
          "description": "Blocks clicks while an action runs. `true` shows a spinner before the label (in place of `leading`); `\"spin-icon\"` spins the `leading` icon."
        },
        {
          "name": "target",
          "type": "React.HTMLAttributeAnchorTarget"
        },
        {
          "name": "download",
          "type": "any"
        },
        {
          "name": "tone",
          "type": "\"link\" | \"default\" | \"outline\" | \"ghost\" | \"success\" | \"danger\" | \"quiet\" | \"inverse\" | \"inverse-outline\"",
          "default": "\"outline\""
        },
        {
          "name": "trailing",
          "type": "React.ReactNode",
          "description": "Content after the label (and after `count`), usually an icon."
        },
        {
          "name": "shape",
          "type": "\"circle\" | \"default\" | \"pill\" | \"square\""
        },
        {
          "name": "block",
          "type": "boolean",
          "description": "Stretches to the full width of its container."
        },
        {
          "name": "count",
          "type": "number",
          "description": "Number shown inline after the label as a notification badge."
        },
        {
          "name": "display",
          "type": "FileActionDisplay",
          "default": "\"icon-text\""
        },
        {
          "name": "rows",
          "type": "ExportSource",
          "required": true
        },
        {
          "name": "columns",
          "type": "ExportColumn[]"
        },
        {
          "name": "fileName",
          "type": "string",
          "default": "\"export\"",
          "description": "`.xlsx` is added when missing."
        },
        {
          "name": "sheetName",
          "type": "string"
        },
        {
          "name": "onExport",
          "type": "((fileName: string) => void)"
        },
        {
          "name": "onExportError",
          "type": "((error: unknown) => void)"
        }
      ],
      "inherits": [
        "ButtonHTMLAttributes",
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "imports": [
        "import { DEMO_EXPORT_COLUMNS, DEMO_EXPORT_ROWS } from \"../shared/definesExportRows\"",
        "import { ExcelButton } from \"@/components/standard/excel-button\""
      ],
      "code": "<div className=\"flex flex-wrap items-center gap-3\">\n  <ExcelButton\n    display={display}\n    rows={DEMO_EXPORT_ROWS}\n    columns={DEMO_EXPORT_COLUMNS}\n    fileName=\"orders\"\n    onExport={setSaved}\n  />\n  <span className=\"font-mono text-xs text-muted-foreground\">\n    {saved ? `Saved ${saved}` : `${DEMO_EXPORT_ROWS.length} orders`}\n  </span>\n</div>"
    }
  ]
}
