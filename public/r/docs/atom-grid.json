{
  "name": "atom-grid",
  "components": [
    {
      "name": "AtomGrid",
      "props": [
        {
          "name": "pattern",
          "type": "\"diamond\" | \"orbit\" | \"pulse\" | \"orbit-duo\" | \"vortex\" | \"spiral\" | \"ripple\" | \"snake\" | \"scan\" | \"wave\" | \"diagonal\" | \"rain\" | \"cross\" | \"saltire\" | \"corners\" | \"checker\" | \"sparkle\" | \"heart\"",
          "default": "\"orbit\""
        },
        {
          "name": "cols",
          "type": "number",
          "default": "5",
          "description": "Dots across; 3 to 9 reads best."
        },
        {
          "name": "rows",
          "type": "number",
          "default": "cols",
          "description": "Dots down; defaults to `cols` for a square grid."
        },
        {
          "name": "dotSize",
          "type": "number",
          "default": "4",
          "description": "Width of one dot, in pixels."
        },
        {
          "name": "gap",
          "type": "number",
          "default": "2",
          "description": "Space between dots, in pixels."
        },
        {
          "name": "speed",
          "type": "number",
          "description": "Seconds for one cycle; each pattern has its own default."
        },
        {
          "name": "shape",
          "type": "\"circle\" | \"square\" | \"diamond\" | \"rounded\"",
          "default": "\"circle\""
        },
        {
          "name": "glow",
          "type": "boolean",
          "default": "false",
          "description": "A soft bloom around lit dots."
        },
        {
          "name": "idleOpacity",
          "type": "number",
          "default": "0.12",
          "description": "Opacity of the dots that are resting, 0 to 1."
        },
        {
          "name": "paused",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "color",
          "type": "string",
          "description": "Dot color; any CSS color. Defaults to the text color."
        },
        {
          "name": "label",
          "type": "string",
          "default": "\"Loading\"",
          "description": "Accessible name for the status."
        },
        {
          "name": "fill",
          "type": "boolean",
          "default": "false",
          "description": "Fit as many dots as the box holds, instead of `cols` by `rows`."
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "fill · behind a card",
      "imports": [
        "import { AtomGrid } from \"@/components/standard/atom-grid\""
      ],
      "setup": "const fillCards: { pattern: AtomGridPattern; title: string; ink: string }[] = [\n  { pattern: \"ripple\", title: \"Generating\", ink: \"var(--primary)\" },\n  { pattern: \"rain\", title: \"Syncing\", ink: \"var(--muted-foreground)\" },\n  { pattern: \"orbit\", title: \"Waiting for review\", ink: \"var(--success)\" },\n]",
      "code": "<div className=\"grid w-full gap-2 sm:grid-cols-3\">\n  {fillCards.map((card) => (\n    <div\n      key={card.pattern}\n      className=\"relative flex h-40 flex-col justify-end overflow-hidden rounded-lg border border-border bg-background p-4\"\n    >\n      <AtomGrid\n        fill\n        pattern={card.pattern}\n        dotSize={4}\n        gap={4}\n        idleOpacity={0.08}\n        color={card.ink}\n        className=\"absolute inset-0\"\n      />\n      <span className=\"relative text-sm font-medium\">{card.title}</span>\n      <span className=\"relative font-mono text-xs text-muted-foreground\">\n        {card.pattern}\n      </span>\n    </div>\n  ))}\n</div>"
    },
    {
      "title": "inline · next to text",
      "imports": [
        "import { AtomGrid } from \"@/components/standard/atom-grid\"",
        "import { Button } from \"@/components/standard/button\""
      ],
      "code": "<div className=\"flex w-full flex-col gap-3 text-sm\">\n  <p className=\"flex items-center gap-2\">\n    <AtomGrid pattern=\"orbit\" cols={3} dotSize={3} gap={1} />\n    Thinking…\n  </p>\n  <p className=\"flex items-center gap-2 text-primary\">\n    <AtomGrid pattern=\"snake\" cols={4} dotSize={3} gap={1} />\n    Syncing 12 files\n  </p>\n  <p className=\"flex items-center gap-2 text-success\">\n    <AtomGrid pattern=\"pulse\" cols={3} dotSize={3} gap={1} glow />\n    Connected\n  </p>\n  <Button tone=\"outline\" size=\"sm\" className=\"w-fit\">\n    <AtomGrid pattern=\"rain\" cols={3} dotSize={2} gap={1} />\n    Deploying\n  </Button>\n</div>"
    },
    {
      "title": "every pattern",
      "imports": [
        "import { AtomGrid, atomGridPatterns } from \"@/components/standard/atom-grid\""
      ],
      "code": "<div className=\"grid w-full grid-cols-3 gap-2 sm:grid-cols-6\">\n  {atomGridPatterns.map((pattern) => (\n    <div\n      key={pattern}\n      className=\"flex flex-col items-center gap-2 rounded-md border border-border py-4\"\n    >\n      <AtomGrid pattern={pattern} cols={7} dotSize={4} gap={2} />\n      <span className=\"font-mono text-xs text-muted-foreground\">\n        {pattern}\n      </span>\n    </div>\n  ))}\n</div>"
    }
  ]
}
