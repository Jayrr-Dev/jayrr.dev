{
  "name": "paragraph",
  "components": [
    {
      "name": "Paragraph",
      "props": [
        {
          "name": "size",
          "type": "\"default\" | \"sm\" | \"muted\" | \"lead\"",
          "default": "\"default\""
        },
        {
          "name": "tone",
          "type": "\"default\" | \"muted\"",
          "default": "\"default\""
        },
        {
          "name": "lineClamp",
          "type": "1 | 2 | 4 | 3"
        },
        {
          "name": "truncate",
          "type": "boolean",
          "default": "false"
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "size sm · tone muted",
      "imports": [
        "import { Paragraph } from \"@/components/standard/paragraph\""
      ],
      "code": "<Paragraph size=\"sm\" tone=\"muted\">\n  Remaining 12.0 h\n</Paragraph>"
    },
    {
      "title": "lineClamp 2",
      "imports": [
        "import { Paragraph } from \"@/components/standard/paragraph\""
      ],
      "setup": "const LONG_TEXT =\n  \"Crews log hours against the job, the board rolls them up by week, and payroll reads the same numbers the foreman signed off on.\"",
      "code": "<Paragraph size=\"sm\" lineClamp={2}>\n  {LONG_TEXT}\n</Paragraph>"
    },
    {
      "title": "truncate",
      "imports": [
        "import { Paragraph } from \"@/components/standard/paragraph\""
      ],
      "setup": "const LONG_TEXT =\n  \"Crews log hours against the job, the board rolls them up by week, and payroll reads the same numbers the foreman signed off on.\"",
      "code": "<Paragraph size=\"sm\" truncate>\n  {LONG_TEXT}\n</Paragraph>"
    },
    {
      "title": "size sm",
      "imports": [
        "import { Paragraph } from \"@/components/standard/paragraph\""
      ],
      "code": "<Paragraph size=\"sm\">Sep 22, 2026 · 8.0 h</Paragraph>"
    }
  ]
}
