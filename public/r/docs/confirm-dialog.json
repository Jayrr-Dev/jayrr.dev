{
  "name": "confirm-dialog",
  "components": [
    {
      "name": "ConfirmDialog",
      "props": [
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "type": "string",
          "required": true
        },
        {
          "name": "trigger",
          "type": "React.ReactNode",
          "default": "\"Confirm\"",
          "description": "A string renders an outline button; pass an element to use your own."
        },
        {
          "name": "confirmLabel",
          "type": "string",
          "default": "\"Confirm\""
        },
        {
          "name": "cancelLabel",
          "type": "string",
          "default": "\"Cancel\""
        },
        {
          "name": "tone",
          "type": "\"default\" | \"danger\"",
          "default": "\"danger\"",
          "description": "`danger` (the default) paints the confirm button red."
        },
        {
          "name": "requireText",
          "type": "string",
          "description": "The confirm button stays disabled until this exact text is typed."
        },
        {
          "name": "onConfirm",
          "type": "(() => void | Promise<unknown>)",
          "description": "Return a promise to keep the dialog open with a spinner on the confirm button until it resolves. It stays open if the promise rejects."
        },
        {
          "name": "open",
          "type": "boolean"
        },
        {
          "name": "defaultOpen",
          "type": "boolean",
          "default": "false"
        },
        {
          "name": "onOpenChange",
          "type": "((open: boolean) => void)"
        }
      ]
    }
  ],
  "examples": [
    {
      "imports": [
        "import { ConfirmDialog } from \"@/components/standard/confirm-dialog\""
      ],
      "code": "<ConfirmDialog\n  title={title}\n  description={description}\n  trigger={trigger}\n  confirmLabel={confirmLabel}\n  tone={tone}\n  requireText={requireText}\n  onConfirm={() => {\n    if (waitMs == null) {\n      setHeld(result)\n      return\n    }\n    return new Promise<void>((resolve) => {\n      window.setTimeout(() => {\n        setHeld(result)\n        resolve()\n      }, waitMs)\n    })\n  }}\n/>\n{showsResult && held ? <span className=\"text-xs\">{held}</span> : null}"
    }
  ]
}
