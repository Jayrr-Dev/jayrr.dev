        "import { Carousel } from \"@/components/standard/carousel\""
      ],
      "code": "<Carousel\n  variant=\"multi-browse\"\n  slides={[\"Family\", \"Festivals\", \"Plants\", \"Travel\", \"Food\", \"Pets\"]}\n/>"
    },
    {
      "title": "Carousel",
      "imports": [
        "import { Carousel } from \"@/components/standard/carousel\""
      ],
      "code": "<Carousel slides={[\"Hours\", \"Cost\", \"Crew\"]} />"
    }
  ]
}
