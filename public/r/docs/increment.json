{
  "name": "increment",
  "components": [
    {
      "name": "Increment",
      "description": "A value you nudge with − and +. Hold a button to repeat. The value itself is a spinbutton: arrow keys step, Page Up/Down step by ten, Home and End jump to `min` and `max`.\n\n<Increment label=\"gap\" defaultValue={32} min={8} max={72} step={8} /> <Increment layout=\"stacked\" aria-label=\"Quantity\" defaultValue={2} min={0} />",
      "props": [
        {
          "name": "value",
          "type": "number"
        },
        {
          "name": "defaultValue",
          "type": "number",
          "default": "0"
        },
        {
          "name": "onChange",
          "type": "((value: number) => void)"
        },
        {
          "name": "min",
          "type": "number",
          "default": "-Infinity"
        },
        {
          "name": "max",
          "type": "number",
          "default": "Infinity"
        },
        {
          "name": "step",
          "type": "number",
          "default": "1"
        },
        {
          "name": "label",
          "type": "string",
          "description": "Word before the value, e.g. \"gap\". Also names it for screen readers."
        },
        {
          "name": "format",
          "type": "((value: number) => React.ReactNode)",
          "description": "How the value reads, e.g. (v) => `${v}px`. Defaults to the number."
        },
        {
          "name": "formatText",
          "type": "((value: number) => string)",
          "description": "Say what the value means for screen readers when `format` adds units."
        },
        {
          "name": "size",
          "type": "\"default\" | \"xs\" | \"sm\"",
          "default": "\"sm\""
        },
        {
          "name": "tone",
          "type": "\"outline\" | \"ghost\" | \"quiet\"",
          "default": "\"outline\""
        },
        {
          "name": "layout",
          "type": "\"inline\" | \"stacked\"",
          "default": "\"inline\"",
          "description": "`inline` puts − and + either side of the value. `stacked` boxes the value like a field, with + over − on its right edge."
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false"
        }
      ],
      "inherits": [
        "HTMLAttributes"
      ]
    }
  ],
  "examples": [
    {
      "title": "stacked",
      "imports": [
        "import { Increment } from \"@/components/standard/increment\""
      ],
      "code": "<div className=\"flex flex-col items-start gap-3\">\n  <Increment\n    layout=\"stacked\"\n    aria-label=\"Quantity\"\n    defaultValue={2}\n    min={0}\n    max={99}\n  />\n  <Increment\n    layout=\"stacked\"\n    tone=\"quiet\"\n    label=\"gap\"\n    defaultValue={32}\n    min={8}\n    max={72}\n    step={8}\n  />\n  <Increment\n    layout=\"stacked\"\n    tone=\"ghost\"\n    size=\"default\"\n    aria-label=\"Minutes\"\n    defaultValue={58}\n    min={0}\n    max={59}\n    format={(value) => String(value).padStart(2, \"0\")}\n  />\n</div>"
    },
    {
      "title": "disabled",
      "imports": [
        "import { Increment } from \"@/components/standard/increment\""
      ],
      "code": "<Increment label=\"gap\" defaultValue={32} disabled />"
    },
    {
      "title": "format · step",
      "imports": [
        "import { Increment } from \"@/components/standard/increment\""
      ],
      "code": "<div className=\"flex flex-col items-start gap-3\">\n  <Increment\n    label=\"opacity\"\n    defaultValue={0.6}\n    min={0}\n    max={1}\n    step={0.1}\n    format={(value) => `${Math.round(value * 100)}%`}\n    formatText={(value) => `${Math.round(value * 100)} percent`}\n  />\n  <Increment\n    defaultValue={3}\n    min={1}\n    max={12}\n    format={(value) => `${value} items`}\n    aria-label=\"Items\"\n  />\n</div>"
    },
    {
      "title": "Increment",
      "imports": [
        "import { Increment } from \"@/components/standard/increment\""
      ],
      "code": "<Increment label=\"gap\" defaultValue={32} min={8} max={72} step={8} />"
    }
  ]
}
